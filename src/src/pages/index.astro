<script>
  // Parallax en ingredientes
  const ingrBg = document.getElementById('ingrBg');
  window.addEventListener('scroll', () => {
    if (!ingrBg) return;
    const section = ingrBg.closest('.ingr');
    if (!section) return;
    const rect = section.getBoundingClientRect();
    const p = -rect.top / (rect.height + window.innerHeight);
    ingrBg.style.transform = `translateY(${p * 60}px)`;
  });
</script>
