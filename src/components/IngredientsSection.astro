---
/**
 * COMPONENTE: IngredientsSection
 * ──────────────────────────────────────────────────────
 * Sección que muestra las notas aromáticas / ingredientes estrella.
 * Visualmente es la sección con imagen de fondo y cards encima.
 */

const ingredients = [
  {
    name: 'Rosa de Damasco',
    origin: 'Bulgaria',
    note: 'Top note',
    description: 'La reina de las flores. Dulce, aterciopelada, con sutiles matices de fruta.',
  },
  {
    name: 'Oud Árabe',
    origin: 'Arabia Saudita',
    note: 'Base note',
    description: 'La madera más preciada del mundo. Rico, profundo, con reminiscencias de miel.',
  },
  {
    name: 'Jazmín Sambac',
    origin: 'India',
    note: 'Heart note',
    description: 'Intensamente floral y casi indólico. La esencia de las noches de verano.',
  },
  {
    name: 'Ámbar Gris',
    origin: 'Océano Índico',
    note: 'Base note',
    description: 'Cálido, marino, con una complejidad terrosa. Fija y amplifica los demás aromas.',
  },
];
---

<section class="ingredients">
  <!-- Imagen de fondo con parallax -->
  <div class="ingredients__bg">
    <img
      src="https://framerusercontent.com/images/Qi3nYHH8jDLxYC6vrOJ1VKaYI.png"
      alt=""
      aria-hidden="true"
      id="parallaxBg"
    />
    <div class="ingredients__bg-overlay"></div>
  </div>

  <div class="container">
    
    <!-- Header -->
    <div class="ingredients__header">
      <div class="ingredients__label">
        <div class="gold-line"></div>
        <span>Ingredients</span>
      </div>
      <h2 class="ingredients__title">
        Nature's finest,<br/>
        distilled for you.
      </h2>
    </div>

    <!-- Grid de ingredientes -->
    <div class="ingredients__grid">
      {ingredients.map((ing, i) => (
        <div class="ingredient-card">
          <div class="ingredient-card__num">0{i+1}</div>
          <div class="ingredient-card__note">{ing.note}</div>
          <h3 class="ingredient-card__name">{ing.name}</h3>
          <p class="ingredient-card__origin">{ing.origin}</p>
          <p class="ingredient-card__desc">{ing.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
.ingredients {
  position: relative;
  padding: 160px 0;
  overflow: hidden;
}

/* Fondo con imagen parallax */
.ingredients__bg {
  position: absolute;
  inset: 0;
}
.ingredients__bg img {
  width: 100%;
  height: 120%;
  object-fit: cover;
  object-position: center;
  opacity: 0.3;
  will-change: transform;
}
.ingredients__bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    var(--c-bg) 0%,
    rgba(10,9,6,0.7) 30%,
    rgba(10,9,6,0.7) 70%,
    var(--c-bg) 100%
  );
}

/* Contenido */
.ingredients__header {
  position: relative;
  z-index: 2;
  margin-bottom: 80px;
}

.ingredients__label {
  display: flex;
  align-items: center;
  gap: 16px;
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--c-gold);
  opacity: 0.7;
  margin-bottom: 24px;
}

.ingredients__title {
  font-size: clamp(36px, 4.5vw, 68px);
  font-weight: 300;
  color: var(--c-cream);
  line-height: 1.1;
}

/* Grid */
.ingredients__grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--c-border);
}

.ingredient-card {
  background: var(--c-bg-card);
  padding: 40px 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: background 0.4s;
}
.ingredient-card:hover {
  background: rgba(201,169,110,0.05);
}

.ingredient-card__num {
  font-family: var(--f-serif);
  font-size: 48px;
  color: var(--c-gold);
  opacity: 0.2;
  line-height: 1;
  margin-bottom: -8px;
}

.ingredient-card__note {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--c-gold);
  opacity: 0.6;
}

.ingredient-card__name {
  font-size: 24px;
  font-weight: 300;
  color: var(--c-cream);
  line-height: 1.2;
}

.ingredient-card__origin {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--c-muted);
}

.ingredient-card__desc {
  font-size: 13px;
  line-height: 1.7;
  color: var(--c-cream);
  opacity: 0.5;
  margin-top: 8px;
}

@media (max-width: 1024px) {
  .ingredients__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 640px) {
  .ingredients__grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  // Efecto parallax simple en el fondo
  const bg = document.getElementById('parallaxBg');
  
  window.addEventListener('scroll', () => {
    if (!bg) return;
    const section = bg.closest('.ingredients');
    if (!section) return;
    
    const rect = section.getBoundingClientRect();
    const progress = -rect.top / (rect.height + window.innerHeight);
    bg.style.transform = `translateY(${progress * 60}px)`;
  });
</script>
