---
/**
 * COMPONENTE: IngredientsSection — Elysian Aromas
 * Ingredientes estrella. Fondo crema, layout editorial,
 * imagen lateral con parallax, cards limpias.
 */

const ingredients = [
  {
    name: 'Rosa de Damasco',
    origin: 'Bulgaria',
    note: 'Nota de salida',
    description: 'La reina de las flores. Dulce, aterciopelada, con sutiles matices de fruta.',
  },
  {
    name: 'Oud Árabe',
    origin: 'Arabia Saudita',
    note: 'Nota de fondo',
    description: 'La madera más preciada del mundo. Rico, profundo, con reminiscencias de miel.',
  },
  {
    name: 'Jazmín Sambac',
    origin: 'India',
    note: 'Nota de corazón',
    description: 'Intensamente floral y casi indólico. La esencia de las noches de verano.',
  },
  {
    name: 'Ámbar Gris',
    origin: 'Océano Índico',
    note: 'Nota de fondo',
    description: 'Cálido, marino, con una complejidad terrosa. Fija y amplifica los demás aromas.',
  },
];
---

<section class="ing" id="ingredientes">
  <div class="ing__inner">

    <!-- Columna izquierda: header + imagen -->
    <div class="ing__left">
      <div class="ing__label">
        <span class="ing__label-line"></span>
        <span>Ingredientes</span>
      </div>
      <h2 class="ing__title">
        Lo mejor de<br />la naturaleza,<br />destilado.
      </h2>

      <div class="ing__img-wrap">
        <img
          id="ingParallaxBg"
          src="https://framerusercontent.com/images/Qi3nYHH8jDLxYC6vrOJ1VKaYI.png"
          alt="Ingredientes Elysian"
          class="ing__img"
          loading="lazy"
        />
        <!-- Número decorativo grande -->
        <span class="ing__deco-num" aria-hidden="true">04</span>
      </div>
    </div>

    <!-- Columna derecha: lista de ingredientes -->
    <div class="ing__right">
      {ingredients.map((ing, i) => (
        <div class="ing-card">
          <div class="ing-card__head">
            <span class="ing-card__num">0{i + 1}</span>
            <span class="ing-card__note">{ing.note}</span>
          </div>
          <div class="ing-card__body">
            <h3 class="ing-card__name">{ing.name}</h3>
            <span class="ing-card__origin">{ing.origin}</span>
          </div>
          <p class="ing-card__desc">{ing.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .ing {
    width: 100%;
    background: #f0ebe2;
    padding: 120px 0 140px;
    font-family: 'Montserrat', system-ui, sans-serif;
    overflow: hidden;
  }

  .ing__inner {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 52px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* ── Izquierda ───────────────────────────────── */
  .ing__left {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ing__label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.45);
    margin-bottom: 24px;
  }
  .ing__label-line {
    display: block;
    width: 32px;
    height: 1px;
    background: rgba(26,26,24,0.3);
    flex-shrink: 0;
  }

  .ing__title {
    font-size: clamp(32px, 3.8vw, 60px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #1a1a18;
    margin: 0 0 48px 0;
  }

  /* Imagen con parallax */
  .ing__img-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/5;
  }

  .ing__img {
    width: 100%;
    height: 110%;
    object-fit: cover;
    object-position: center;
    will-change: transform;
    display: block;
  }

  /* Número decorativo sobre la imagen */
  .ing__deco-num {
    position: absolute;
    bottom: 20px;
    right: 24px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 96px;
    font-weight: 300;
    line-height: 1;
    color: rgba(240,235,226,0.25);
    pointer-events: none;
    user-select: none;
  }

  /* ── Derecha: cards ──────────────────────────── */
  .ing__right {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-top: 8px;
  }

  .ing-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 32px 0;
    border-bottom: 1px solid rgba(26,26,24,0.1);
    transition: padding-left 0.3s ease;
    cursor: default;
  }
  .ing-card:first-child { border-top: 1px solid rgba(26,26,24,0.1); }
  .ing-card:hover { padding-left: 12px; }

  .ing-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ing-card__num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 36px;
    font-weight: 300;
    color: rgba(26,26,24,0.15);
    line-height: 1;
  }

  .ing-card__note {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.4);
    background: rgba(26,26,24,0.06);
    padding: 5px 12px;
    border-radius: 999px;
  }

  .ing-card__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .ing-card__name {
    font-size: clamp(20px, 2vw, 30px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: #1a1a18;
    margin: 0;
  }

  .ing-card__origin {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.35);
    white-space: nowrap;
  }

  .ing-card__desc {
    font-size: 13px;
    line-height: 1.75;
    color: rgba(26,26,24,0.55);
    margin: 0;
    max-width: 440px;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1024px) {
    .ing__inner { grid-template-columns: 1fr; gap: 56px; padding: 0 32px; }
    .ing__left  { position: static; }
    .ing__img-wrap { aspect-ratio: 16/9; }
    .ing__img   { height: 100%; }
  }

  @media (max-width: 640px) {
    .ing         { padding: 80px 0 100px; }
    .ing__inner  { padding: 0 20px; gap: 40px; }
    .ing__title  { font-size: clamp(28px, 9vw, 44px); }
    .ing-card    { padding: 24px 0; }
    .ing-card__name { font-size: clamp(18px, 5.5vw, 24px); }
    .ing-card:hover { padding-left: 0; }
  }
</style>

<script is:inline>
(function () {
  var img = document.getElementById('ingParallaxBg');
  if (!img) return;

  var ticking = false;

  function update() {
    var section = img.closest('.ing');
    if (!section) return;
    var rect = section.getBoundingClientRect();
    var progress = -rect.top / (rect.height + window.innerHeight);
    img.style.transform = 'translateY(' + (progress * 50) + 'px)';
    ticking = false;
  }

  window.addEventListener('scroll', function () {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });

  update();
})();
</script>