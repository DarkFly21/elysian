---
/**
 * COMPONENTE: ProductCard — Elysian Aromas
 * Card limpia: imagen arriba con hover zoom,
 * info abajo sobre fondo crema. Botón estilo nav.
 */

interface Props {
  id: number;
  slug: string;
  title: string;
  excerpt?: string;
  price?: string;
  image?: string;
  imageAlt?: string;
  notes?: string[];
  featured?: boolean;
}

const {
  slug,
  title,
  excerpt = '',
  price = '€180',
  image,
  imageAlt = title,
  notes = [],
  featured = false,
} = Astro.props;

const imageSrc = image || 'https://framerusercontent.com/images/9p6ZdVRkfJqY0sgtSIUbUvrY4T8.jpg';
---

<article class:list={['pc', { 'pc--featured': featured }]}>
  <a href={`/coleccion/${slug}`} class="pc__link" aria-label={title}>

    <!-- Imagen -->
    <div class="pc__img-wrap">
      <img src={imageSrc} alt={imageAlt} class="pc__img" loading="lazy" />

      {notes.length > 0 && (
        <span class="pc__notes">{notes.slice(0, 3).join(' · ')}</span>
      )}
    </div>

    <!-- Info -->
    <div class="pc__info">
      <div class="pc__info-top">
        <h3 class="pc__title">{title}</h3>
        {excerpt && (
          <p class="pc__excerpt" set:html={excerpt} />
        )}
      </div>

      <div class="pc__footer">
        <span class="pc__price">{price}</span>
        <span class="pc__cta">
          Ver
          <span class="pc__cta-dots" aria-hidden="true">••</span>
        </span>
      </div>
    </div>

  </a>
</article>

<style>
  .pc {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #eae4d9;
    font-family: 'Montserrat', system-ui, sans-serif;
    display: flex;
    flex-direction: column;
  }

  .pc__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  /* ── Imagen ──────────────────────────────────── */
  .pc__img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    flex-shrink: 0;
  }

  .pc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .pc:hover .pc__img { transform: scale(1.06); }

  /* Pill de notas aromáticas */
  .pc__notes {
    position: absolute;
    top: 16px;
    left: 16px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.55);
    background: rgba(240,235,226,0.75);
    border: 1px solid rgba(26,26,24,0.08);
    padding: 5px 12px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  /* ── Info ────────────────────────────────────── */
  .pc__info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding: 20px 20px 18px;
    background: #f0ebe2;
    border-top: 1px solid rgba(26,26,24,0.07);
    gap: 16px;
  }

  .pc__info-top { display: flex; flex-direction: column; gap: 6px; }

  .pc__title {
    font-size: clamp(16px, 1.6vw, 22px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: #1a1a18;
    margin: 0;
  }
  .pc--featured .pc__title { font-size: clamp(20px, 2vw, 28px); }

  .pc__excerpt {
    font-size: 12px;
    line-height: 1.6;
    color: rgba(26,26,24,0.5);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc__excerpt p { margin: 0; }

  /* ── Footer ──────────────────────────────────── */
  .pc__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid rgba(26,26,24,0.08);
  }

  .pc__price {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 300;
    font-style: italic;
    color: #1a1a18;
    letter-spacing: 0.02em;
  }

  /* Botón estilo nav — pill oscuro */
  .pc__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    height: 36px;
    border-radius: 999px;
    background: #1a1a18;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f0ebe2;
    transition: background 0.25s, transform 0.2s;
  }
  .pc__cta-dots {
    font-size: 7px;
    letter-spacing: 2px;
    opacity: 0.5;
  }
  .pc:hover .pc__cta {
    background: #2e2e2b;
    transform: scale(1.03);
  }
</style>