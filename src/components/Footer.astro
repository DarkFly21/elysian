---
/**
 * COMPONENTE: Footer — Elysian Aromas
 * Layout editorial: título gigante, newsletter inline,
 * grid de links limpio. Fondo oscuro que contrasta con el sitio crema.
 */

const currentYear = new Date().getFullYear();
---

<footer class="ft">

  <!-- CTA grande superior -->
  <div class="ft__top">
    <div class="ft__top-inner">
      <div class="ft__top-left">
        <p class="ft__top-label">
          <span class="ft__top-label-line"></span>
          Únete a la esencia
        </p>
        <h2 class="ft__big-title">
          Mantente<br/>en la esencia.
        </h2>
      </div>
      <div class="ft__top-right">
        <p class="ft__newsletter-sub">
          Nuevas colecciones, ofertas exclusivas<br />e historias olfativas directamente<br />en tu bandeja de entrada.
        </p>
        <div class="ft__form">
          <input
            type="email"
            placeholder="Tu correo electrónico"
            class="ft__input"
            aria-label="Correo electrónico"
          />
          <button class="ft__btn">
            Suscribirse
            <span class="ft__btn-dots" aria-hidden="true">••</span>
          </button>
        </div>
        <p class="ft__form-note">Sin spam. Cancela cuando quieras.</p>
      </div>
    </div>
  </div>

  <!-- Separador con logo centrado -->
  <div class="ft__divider">
    <div class="ft__divider-line"></div>
    <a href="/" class="ft__logo" aria-label="Elysian Aromas">ELYSIAN</a>
    <div class="ft__divider-line"></div>
  </div>

  <!-- Links + social -->
  <div class="ft__mid">
    <div class="ft__mid-inner">

      <div class="ft__links-group">
        <h4 class="ft__links-title">Páginas</h4>
        <nav class="ft__links">
          <a href="/">Inicio</a>
          <a href="/coleccion">Colección</a>
          <a href="/nosotros">Nosotros</a>
          <a href="/contacto">Contacto</a>
        </nav>
      </div>

      <div class="ft__links-group">
        <h4 class="ft__links-title">Legal</h4>
        <nav class="ft__links">
          <a href="/privacidad">Privacidad</a>
          <a href="/terminos">Términos</a>
          <a href="/envios">Envíos y devoluciones</a>
        </nav>
      </div>

      <div class="ft__links-group">
        <h4 class="ft__links-title">Contacto</h4>
        <nav class="ft__links">
          <a href="mailto:hola@elysianaromas.com">hola@elysianaromas.com</a>
          <a href="tel:+34900000000">+34 900 000 000</a>
          <span>Lun–Vie, 10am–6pm</span>
        </nav>
      </div>

      <div class="ft__links-group">
        <h4 class="ft__links-title">Síguenos</h4>
        <div class="ft__social">
          <a href="#" class="ft__social-link" aria-label="Instagram">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
            Instagram
          </a>
          <a href="#" class="ft__social-link" aria-label="TikTok">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            TikTok
          </a>
          <a href="#" class="ft__social-link" aria-label="X">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24">
              <path d="M4 4l16 16M4 20L20 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            X / Twitter
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="ft__bottom">
    <div class="ft__bottom-inner">
      <p>© {currentYear} Elysian Aromas Inc. Todos los derechos reservados.</p>
      <p class="ft__tagline">Fragancias divinas para quienes se atreven a ser inolvidables.</p>
      <p>Fotografías: Unsplash & Pinterest</p>
    </div>
  </div>

</footer>

<style>
  .ft {
    width: 100%;
    background: #1a1a18;
    font-family: 'Montserrat', system-ui, sans-serif;
    color: #f0ebe2;
  }

  /* ── Top: CTA + newsletter ───────────────────── */
  .ft__top {
    padding: 96px 52px 80px;
    border-bottom: 1px solid rgba(240,235,226,0.07);
  }

  .ft__top-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
  }

  .ft__top-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240,235,226,0.3);
    margin: 0 0 24px 0;
  }
  .ft__top-label-line {
    display: block;
    width: 28px;
    height: 1px;
    background: rgba(240,235,226,0.2);
    flex-shrink: 0;
  }

  .ft__big-title {
    font-size: clamp(40px, 5.5vw, 84px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #f0ebe2;
    margin: 0;
  }

  .ft__top-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 4px;
  }

  .ft__newsletter-sub {
    font-size: 13px;
    line-height: 1.8;
    color: rgba(240,235,226,0.4);
    margin: 0;
  }

  /* Form pill */
  .ft__form {
    display: flex;
    border: 1px solid rgba(240,235,226,0.12);
    border-radius: 999px;
    overflow: hidden;
    background: rgba(240,235,226,0.04);
    transition: border-color 0.3s;
  }
  .ft__form:focus-within {
    border-color: rgba(240,235,226,0.3);
  }

  .ft__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0 22px;
    height: 50px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 13px;
    color: #f0ebe2;
    outline: none;
    min-width: 0;
  }
  .ft__input::placeholder { color: rgba(240,235,226,0.25); }

  .ft__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 22px;
    height: 50px;
    background: #f0ebe2;
    border: none;
    border-radius: 999px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1a18;
    cursor: pointer;
    transition: background 0.25s, transform 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ft__btn:hover { background: #ddd8cf; transform: scale(1.02); }
  .ft__btn-dots { font-size: 7px; letter-spacing: 2px; opacity: 0.4; }

  .ft__form-note {
    font-size: 10px;
    color: rgba(240,235,226,0.2);
    margin: 0;
    padding-left: 4px;
  }

  /* ── Divider con logo ────────────────────────── */
  .ft__divider {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 0 52px;
    margin: 0 auto;
    max-width: 1404px; /* 1300 + 2*52 */
  }

  .ft__divider-line {
    flex: 1;
    height: 1px;
    background: rgba(240,235,226,0.07);
  }

  .ft__logo {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.6em;
    color: rgba(240,235,226,0.3);
    text-decoration: none;
    white-space: nowrap;
    padding: 28px 0;
    display: block;
    transition: color 0.3s;
  }
  .ft__logo:hover { color: rgba(240,235,226,0.7); }

  /* ── Links + social ──────────────────────────── */
  .ft__mid {
    padding: 48px 52px 56px;
    border-bottom: 1px solid rgba(240,235,226,0.07);
  }

  .ft__mid-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
  }

  .ft__links-title {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240,235,226,0.25);
    margin: 0 0 18px 0;
  }

  .ft__links {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .ft__links a,
  .ft__links span {
    font-size: 13px;
    color: rgba(240,235,226,0.45);
    text-decoration: none;
    transition: color 0.25s;
  }
  .ft__links a:hover { color: #f0ebe2; }

  /* Social como lista de links con icono */
  .ft__social {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .ft__social-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: rgba(240,235,226,0.45);
    text-decoration: none;
    transition: color 0.25s;
  }
  .ft__social-link:hover { color: #f0ebe2; }

  /* ── Bottom ──────────────────────────────────── */
  .ft__bottom {
    padding: 20px 52px;
  }

  .ft__bottom-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
    color: rgba(240,235,226,0.18);
    letter-spacing: 0.04em;
    gap: 24px;
  }

  .ft__tagline {
    font-style: italic;
    opacity: 0.8;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1024px) {
    .ft__top { padding: 72px 32px 64px; }
    .ft__top-inner { grid-template-columns: 1fr; gap: 48px; align-items: start; }
    .ft__divider { padding: 0 32px; }
    .ft__mid { padding: 40px 32px 48px; }
    .ft__mid-inner { grid-template-columns: repeat(2, 1fr); gap: 36px; }
    .ft__bottom { padding: 20px 32px; }
    .ft__bottom-inner { flex-direction: column; text-align: center; gap: 6px; }
  }

  @media (max-width: 640px) {
    .ft__top { padding: 56px 20px 48px; }
    .ft__big-title { font-size: clamp(36px, 11vw, 56px); }
    .ft__form { border-radius: 14px; flex-direction: column; padding: 6px; gap: 6px; }
    .ft__input { height: 44px; border-radius: 10px; }
    .ft__btn { height: 44px; justify-content: center; border-radius: 10px; }
    .ft__divider { padding: 0 20px; }
    .ft__mid { padding: 36px 20px 44px; }
    .ft__mid-inner { grid-template-columns: 1fr 1fr; gap: 28px; }
    .ft__bottom { padding: 18px 20px; }
    .ft__bottom-inner .ft__tagline { display: none; }
  }
</style>