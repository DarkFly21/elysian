---
/**
 * COMPONENTE: Footer — Elysian Aromas
 * Estilo crema coherente con el resto del sitio.
 * Newsletter, links, social, copyright.
 */

const currentYear = new Date().getFullYear();
---

<footer class="ft">

  <!-- Newsletter strip -->
  <div class="ft__newsletter">
    <div class="ft__newsletter-inner">
      <div class="ft__newsletter-left">
        <div class="ft__label">
          <span class="ft__label-line"></span>
          <span>Newsletter</span>
        </div>
        <h3 class="ft__newsletter-title">
          Mantente en<br />la esencia.
        </h3>
        <p class="ft__newsletter-sub">
          Nuevas colecciones, ofertas exclusivas, historias olfativas.
        </p>
      </div>

      <div class="ft__newsletter-right">
        <div class="ft__form">
          <input
            type="email"
            placeholder="Tu correo electrónico"
            class="ft__input"
            aria-label="Correo electrónico"
          />
          <button class="ft__btn">
            Suscribirse
            <span class="ft__btn-dots" aria-hidden="true">••</span>
          </button>
        </div>
        <p class="ft__form-note">Sin spam. Cancela cuando quieras.</p>
      </div>
    </div>
  </div>

  <!-- Main -->
  <div class="ft__main">
    <div class="ft__main-inner">

      <!-- Brand col -->
      <div class="ft__brand">
        <a href="/" class="ft__logo">ELYSIAN</a>
        <p class="ft__tagline">
          Fragancias divinas para quienes<br />se atreven a ser inolvidables.
        </p>
        <div class="ft__social">
          <a href="#" class="ft__social-link" aria-label="Instagram">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </a>
          <a href="#" class="ft__social-link" aria-label="X / Twitter">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24">
              <path d="M4 4l16 16M4 20L20 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
          <a href="#" class="ft__social-link" aria-label="TikTok">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links cols -->
      <div class="ft__links-group">
        <h4 class="ft__links-title">Páginas</h4>
        <nav class="ft__links">
          <a href="/">Inicio</a>
          <a href="/coleccion">Colección</a>
          <a href="/nosotros">Nosotros</a>
          <a href="/contacto">Contacto</a>
        </nav>
      </div>

      <div class="ft__links-group">
        <h4 class="ft__links-title">Legal</h4>
        <nav class="ft__links">
          <a href="/privacidad">Privacidad</a>
          <a href="/terminos">Términos</a>
          <a href="/envios">Envíos y devoluciones</a>
        </nav>
      </div>

      <div class="ft__links-group">
        <h4 class="ft__links-title">Contacto</h4>
        <nav class="ft__links">
          <a href="mailto:hola@elysianaromas.com">hola@elysianaromas.com</a>
          <a href="tel:+34900000000">+34 900 000 000</a>
          <span>Lun–Vie, 10am–6pm</span>
        </nav>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="ft__bottom">
      <p>© {currentYear} Elysian Aromas Inc. Todos los derechos reservados.</p>
      <p class="ft__credit">Fotografías por Unsplash & Pinterest</p>
    </div>

  </div>

</footer>

<style>
  .ft {
    width: 100%;
    background: #1a1a18;
    font-family: 'Montserrat', system-ui, sans-serif;
  }

  /* ── Newsletter ──────────────────────────────── */
  .ft__newsletter {
    padding: 80px 52px;
    border-bottom: 1px solid rgba(240,235,226,0.08);
  }

  .ft__newsletter-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .ft__label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240,235,226,0.35);
    margin-bottom: 20px;
  }
  .ft__label-line {
    display: block;
    width: 28px;
    height: 1px;
    background: rgba(240,235,226,0.25);
    flex-shrink: 0;
  }

  .ft__newsletter-title {
    font-size: clamp(28px, 3.5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #f0ebe2;
    margin: 0 0 16px 0;
  }

  .ft__newsletter-sub {
    font-size: 13px;
    line-height: 1.7;
    color: rgba(240,235,226,0.45);
    margin: 0;
  }

  /* Form */
  .ft__newsletter-right {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ft__form {
    display: flex;
    gap: 0;
    border: 1px solid rgba(240,235,226,0.15);
    border-radius: 999px;
    overflow: hidden;
    background: rgba(240,235,226,0.04);
    transition: border-color 0.3s;
  }
  .ft__form:focus-within {
    border-color: rgba(240,235,226,0.35);
  }

  .ft__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0 24px;
    height: 52px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 13px;
    color: #f0ebe2;
    outline: none;
    min-width: 0;
  }
  .ft__input::placeholder { color: rgba(240,235,226,0.3); }

  /* Botón estilo nav */
  .ft__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 24px;
    height: 52px;
    background: #f0ebe2;
    border: none;
    border-radius: 999px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1a18;
    cursor: pointer;
    transition: background 0.25s, transform 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ft__btn:hover {
    background: #e0dbd2;
    transform: scale(1.02);
  }
  .ft__btn-dots {
    font-size: 7px;
    letter-spacing: 2px;
    opacity: 0.45;
  }

  .ft__form-note {
    font-size: 10px;
    color: rgba(240,235,226,0.25);
    margin: 0;
    padding-left: 4px;
  }

  /* ── Main ────────────────────────────────────── */
  .ft__main {
    padding: 72px 52px 40px;
  }

  .ft__main-inner {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(240,235,226,0.08);
    margin-bottom: 32px;
  }

  /* Brand */
  .ft__logo {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 26px;
    font-weight: 300;
    letter-spacing: 0.35em;
    color: #f0ebe2;
    text-decoration: none;
    display: block;
    margin-bottom: 18px;
    transition: opacity 0.3s;
  }
  .ft__logo:hover { opacity: 0.7; }

  .ft__tagline {
    font-size: 12px;
    line-height: 1.8;
    color: rgba(240,235,226,0.35);
    margin: 0 0 28px 0;
  }

  .ft__social {
    display: flex;
    gap: 14px;
  }
  .ft__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(240,235,226,0.12);
    color: rgba(240,235,226,0.45);
    text-decoration: none;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
  }
  .ft__social-link:hover {
    border-color: rgba(240,235,226,0.4);
    color: #f0ebe2;
    background: rgba(240,235,226,0.06);
  }

  /* Links cols */
  .ft__links-title {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240,235,226,0.3);
    margin: 0 0 20px 0;
  }

  .ft__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ft__links a,
  .ft__links span {
    font-size: 13px;
    color: rgba(240,235,226,0.5);
    text-decoration: none;
    transition: color 0.25s;
  }
  .ft__links a:hover { color: #f0ebe2; }

  /* Bottom */
  .ft__bottom {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    color: rgba(240,235,226,0.2);
    letter-spacing: 0.04em;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1024px) {
    .ft__newsletter { padding: 60px 32px; }
    .ft__newsletter-inner { grid-template-columns: 1fr; gap: 40px; }
    .ft__main { padding: 60px 32px 32px; }
    .ft__main-inner { grid-template-columns: 1fr 1fr; gap: 40px; }
    .ft__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .ft__newsletter { padding: 48px 20px; }
    .ft__newsletter-title { font-size: clamp(24px, 8vw, 36px); }
    .ft__form { border-radius: 16px; flex-direction: column; padding: 8px; gap: 8px; }
    .ft__input { height: 44px; border-radius: 10px; }
    .ft__btn { height: 44px; justify-content: center; border-radius: 10px; }
    .ft__main { padding: 48px 20px 24px; }
    .ft__main-inner { grid-template-columns: 1fr; gap: 32px; }
    .ft__bottom { flex-direction: column; gap: 6px; text-align: center; }
  }
</style>