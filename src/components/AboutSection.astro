---
/**
 * COMPONENTE: AboutSection
 * ──────────────────────────────────────────────────────
 * Sección "Inspired by heavenly realms" con imagen grande.
 * En WordPress headless, este contenido podría venir de:
 * - Una página con slug "about" en WordPress
 * - Un ACF Options Page (settings globales del sitio)
 */
---

<section class="about">
  <div class="about__inner">

    <!-- Columna imagen -->
    <div class="about__visual">
      <div class="about__img-wrap">
        <img
          src="https://framerusercontent.com/images/MYZxK82zNzoKWlZ6byhg3sMiA1k.png"
          alt="Elysian Aromas — Proceso artesanal"
          class="about__img"
          loading="lazy"
        />
        <!-- Badge flotante -->
        <div class="about__badge">
          <span class="about__badge-num">12</span>
          <span class="about__badge-label">Unique<br/>Scents</span>
        </div>
      </div>
    </div>

    <!-- Columna texto -->
    <div class="about__content">
      <div class="about__label">
        <div class="gold-line"></div>
        <span>Our Philosophy</span>
      </div>

      <h2 class="about__title">
        Where heaven<br />
        meets the senses.
      </h2>

      <p class="about__text">
        At Elysian, we believe fragrance is more than scent — it is memory, 
        emotion, and identity crystallized in a bottle. Each formula is crafted 
        with rare ingredients sourced from the world's most exquisite regions.
      </p>

      <p class="about__text">
        Our perfumers spend months refining each composition, balancing ancient 
        traditions with contemporary artistry to create something truly timeless.
      </p>

      <!-- Stats -->
      <div class="about__stats">
        <div class="about__stat">
          <span class="about__stat-num">08</span>
          <span class="about__stat-label">Years of Craft</span>
        </div>
        <div class="about__stat">
          <span class="about__stat-num">42</span>
          <span class="about__stat-label">Rare Ingredients</span>
        </div>
        <div class="about__stat">
          <span class="about__stat-num">∞</span>
          <span class="about__stat-label">Memories Created</span>
        </div>
      </div>

      <a href="/nosotros" class="btn-primary" style="display:inline-block; margin-top: 48px;">
        Discover Our Story
      </a>
    </div>

  </div>
</section>

<style>
.about {
  padding: 120px 0;
  overflow: hidden;
}

.about__inner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 48px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* Visual */
.about__visual {
  position: relative;
}
.about__img-wrap {
  position: relative;
  overflow: visible;
}
.about__img {
  width: 100%;
  height: 600px;
  object-fit: cover;
  filter: brightness(0.85);
}

/* Badge flotante */
.about__badge {
  position: absolute;
  bottom: -24px;
  right: -24px;
  width: 120px;
  height: 120px;
  background: var(--c-gold);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.about__badge-num {
  font-family: var(--f-serif);
  font-size: 40px;
  color: var(--c-bg);
  line-height: 1;
}
.about__badge-label {
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--c-bg);
  text-align: center;
  opacity: 0.7;
}

/* Contenido */
.about__label {
  display: flex;
  align-items: center;
  gap: 16px;
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--c-gold);
  opacity: 0.7;
  margin-bottom: 28px;
}

.about__title {
  font-size: clamp(36px, 4vw, 62px);
  font-weight: 300;
  color: var(--c-cream);
  margin-bottom: 32px;
  line-height: 1.1;
}

.about__text {
  font-size: 14px;
  line-height: 1.8;
  color: var(--c-cream);
  opacity: 0.6;
  margin-bottom: 16px;
}

/* Stats */
.about__stats {
  display: flex;
  gap: 48px;
  margin-top: 48px;
  padding-top: 40px;
  border-top: 1px solid var(--c-border);
}

.about__stat {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.about__stat-num {
  font-family: var(--f-serif);
  font-size: 40px;
  color: var(--c-gold);
  line-height: 1;
}
.about__stat-label {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.5;
}

@media (max-width: 1024px) {
  .about__inner {
    grid-template-columns: 1fr;
    gap: 60px;
    padding: 0 24px;
  }
  .about__img { height: 400px; }
}
</style>
