---
/**
 * COMPONENTE: AboutSection — Elysian Aromas
 * Contador animado en stats, botón estilo nav.
 */
---

<section class="abt" id="nosotros">
  <div class="abt__inner">

    <!-- Imagen izquierda -->
    <div class="abt__visual">
      <div class="abt__img-wrap">
        <img
          src="https://framerusercontent.com/images/MYZxK82zNzoKWlZ6byhg3sMiA1k.png"
          alt="Elysian Aromas — Proceso artesanal"
          class="abt__img"
          loading="lazy"
        />
        <div class="abt__badge">
          <span class="abt__badge-num">12</span>
          <span class="abt__badge-label">Aromas<br/>únicos</span>
        </div>
      </div>
      <div class="abt__side-line" aria-hidden="true">
        <span>EST. 2024</span>
      </div>
    </div>

    <!-- Texto derecha -->
    <div class="abt__content">

      <div class="abt__label">
        <span class="abt__label-line"></span>
        <span>Nuestra Filosofía</span>
      </div>

      <h2 class="abt__title">
        Donde el cielo<br />
        toca los sentidos.
      </h2>

      <p class="abt__text">
        En Elysian creemos que la fragancia es más que un aroma — es memoria, 
        emoción e identidad cristalizada en un frasco. Cada fórmula está elaborada 
        con ingredientes raros provenientes de las regiones más exquisitas del mundo.
      </p>

      <p class="abt__text">
        Nuestros perfumistas dedican meses a refinar cada composición, equilibrando 
        tradiciones ancestrales con artesanía contemporánea para crear algo verdaderamente atemporal.
      </p>

      <!-- Stats con contador -->
      <div class="abt__stats">
        <div class="abt__stat">
          <span class="abt__stat-num" data-target="8" data-suffix="">
            <span class="abt__counter">0</span>
          </span>
          <span class="abt__stat-label">Años de oficio</span>
        </div>
        <div class="abt__stat">
          <span class="abt__stat-num" data-target="42" data-suffix="">
            <span class="abt__counter">0</span>
          </span>
          <span class="abt__stat-label">Ingredientes raros</span>
        </div>
        <div class="abt__stat">
          <span class="abt__stat-num abt__stat-num--inf">
            <span>∞</span>
          </span>
          <span class="abt__stat-label">Recuerdos creados</span>
        </div>
      </div>

      <!-- Botón estilo nav -->
      <a href="/nosotros" class="abt__cta">
        Conoce nuestra historia
        <span class="abt__cta-dots" aria-hidden="true">••</span>
      </a>

    </div>
  </div>
</section>

<style>
  .abt {
    width: 100%;
    background: #f0ebe2;
    padding: 120px 0 140px;
    font-family: 'Montserrat', system-ui, sans-serif;
    overflow: hidden;
  }

  .abt__inner {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 52px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 96px;
    align-items: center;
  }

  /* ── Visual ──────────────────────────────────── */
  .abt__visual {
    position: relative;
  }

  .abt__img-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .abt__img {
    width: 100%;
    height: 620px;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .abt__img-wrap:hover .abt__img { transform: scale(1.04); }

  /* Badge */
  .abt__badge {
    position: absolute;
    bottom: 28px;
    right: -20px;
    width: 110px;
    height: 110px;
    background: #1a1a18;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.18);
  }
  .abt__badge-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 38px;
    font-weight: 300;
    color: #f0ebe2;
    line-height: 1;
  }
  .abt__badge-label {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240,235,226,0.55);
    text-align: center;
    line-height: 1.4;
  }

  /* Texto lateral rotado */
  .abt__side-line {
    position: absolute;
    left: -36px;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    white-space: nowrap;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: rgba(26,26,24,0.2);
    text-transform: uppercase;
  }

  /* ── Contenido ───────────────────────────────── */
  .abt__content { display: flex; flex-direction: column; }

  .abt__label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.45);
    margin-bottom: 28px;
  }
  .abt__label-line {
    display: block;
    width: 32px;
    height: 1px;
    background: rgba(26,26,24,0.3);
    flex-shrink: 0;
  }

  .abt__title {
    font-size: clamp(36px, 4vw, 64px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #1a1a18;
    margin: 0 0 36px 0;
  }

  .abt__text {
    font-size: 14px;
    line-height: 1.8;
    color: rgba(26,26,24,0.6);
    margin: 0 0 16px 0;
  }

  /* ── Stats ───────────────────────────────────── */
  .abt__stats {
    display: flex;
    gap: 0;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid rgba(26,26,24,0.1);
  }

  .abt__stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    padding-right: 24px;
  }
  .abt__stat + .abt__stat {
    padding-left: 24px;
    padding-right: 24px;
    border-left: 1px solid rgba(26,26,24,0.1);
  }
  .abt__stat:last-child { padding-right: 0; }

  .abt__stat-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 48px;
    font-weight: 300;
    color: #1a1a18;
    line-height: 1;
    letter-spacing: -0.02em;
    display: block;
  }
  .abt__stat-num--inf { font-size: 52px; }

  .abt__stat-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.45);
  }

  /* ── Botón estilo nav ────────────────────────── */
  .abt__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 52px;
    align-self: flex-start;
    padding: 0 24px;
    height: 46px;
    border-radius: 999px;
    background: #1a1a18;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f0ebe2;
    text-decoration: none;
    transition: background 0.25s, transform 0.2s;
  }
  .abt__cta:hover {
    background: #2e2e2b;
    transform: scale(1.02);
  }
  .abt__cta-dots {
    font-size: 8px;
    letter-spacing: 2px;
    opacity: 0.55;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1024px) {
    .abt__inner { grid-template-columns: 1fr; gap: 56px; padding: 0 32px; }
    .abt__img   { height: 460px; }
    .abt__side-line { display: none; }
    .abt__badge { right: 16px; bottom: 16px; }
  }

  @media (max-width: 640px) {
    .abt        { padding: 80px 0 100px; }
    .abt__inner { padding: 0 20px; gap: 40px; }
    .abt__img   { height: 340px; }
    .abt__title { font-size: clamp(30px, 9vw, 44px); }
    .abt__stat-num { font-size: 38px; }
    .abt__badge { width: 90px; height: 90px; }
    .abt__badge-num { font-size: 30px; }
  }
</style>

<script is:inline>
(function () {
  function animateCounter(el, target, duration) {
    var start = 0;
    var startTime = null;

    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / duration, 1);
      // ease out cubic
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.floor(eased * target);
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = target;
    }
    requestAnimationFrame(step);
  }

  function initCounters() {
    var stats = document.querySelectorAll('.abt__stat-num[data-target]');
    if (!stats.length) return;

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var wrap = entry.target;
        var target = parseInt(wrap.getAttribute('data-target'), 10);
        var counter = wrap.querySelector('.abt__counter');
        if (counter) animateCounter(counter, target, 1800);
        observer.unobserve(wrap);
      });
    }, { threshold: 0.5 });

    stats.forEach(function (el) { observer.observe(el); });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCounters);
  } else {
    initCounters();
  }
})();
</script>