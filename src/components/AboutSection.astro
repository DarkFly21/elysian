---
/**
 * COMPONENTE: AboutSection — Elysian Aromas
 * Layout asimétrico, imagen grande izquierda, texto derecha.
 * Estilo crema/oscuro coherente con el hero.
 */
---

<section class="abt" id="nosotros">
  <div class="abt__inner">

    <!-- Imagen izquierda -->
    <div class="abt__visual">
      <div class="abt__img-wrap">
        <img
          src="https://framerusercontent.com/images/MYZxK82zNzoKWlZ6byhg3sMiA1k.png"
          alt="Elysian Aromas — Proceso artesanal"
          class="abt__img"
          loading="lazy"
        />
        <!-- Badge flotante -->
        <div class="abt__badge">
          <span class="abt__badge-num">12</span>
          <span class="abt__badge-label">Aromas<br/>únicos</span>
        </div>
      </div>

      <!-- Línea decorativa lateral -->
      <div class="abt__side-line" aria-hidden="true">
        <span>EST. 2024</span>
      </div>
    </div>

    <!-- Texto derecha -->
    <div class="abt__content">

      <div class="abt__label">
        <span class="abt__label-line"></span>
        <span>Nuestra Filosofía</span>
      </div>

      <h2 class="abt__title">
        Donde el cielo<br />
        toca los sentidos.
      </h2>

      <p class="abt__text">
        En Elysian creemos que la fragancia es más que un aroma — es memoria, 
        emoción e identidad cristalizada en un frasco. Cada fórmula está elaborada 
        con ingredientes raros provenientes de las regiones más exquisitas del mundo.
      </p>

      <p class="abt__text">
        Nuestros perfumistas dedican meses a refinar cada composición, equilibrando 
        tradiciones ancestrales con artesanía contemporánea para crear algo verdaderamente atemporal.
      </p>

      <!-- Stats -->
      <div class="abt__stats">
        <div class="abt__stat">
          <span class="abt__stat-num">08</span>
          <span class="abt__stat-label">Años de oficio</span>
        </div>
        <div class="abt__stat">
          <span class="abt__stat-num">42</span>
          <span class="abt__stat-label">Ingredientes raros</span>
        </div>
        <div class="abt__stat">
          <span class="abt__stat-num">∞</span>
          <span class="abt__stat-label">Recuerdos creados</span>
        </div>
      </div>

      <a href="/nosotros" class="abt__cta">
        Conoce nuestra historia
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M1 8h14M9 2l6 6-6 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

    </div>
  </div>
</section>

<style>
  .abt {
    width: 100%;
    background: #f0ebe2;
    padding: 120px 0 140px;
    font-family: 'Montserrat', system-ui, sans-serif;
    overflow: hidden;
  }

  .abt__inner {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 52px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 96px;
    align-items: center;
  }

  /* ── Visual ──────────────────────────────────── */
  .abt__visual {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  .abt__img-wrap {
    position: relative;
    flex: 1;
    border-radius: 20px;
    overflow: hidden;
  }

  .abt__img {
    width: 100%;
    height: 620px;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .abt__img-wrap:hover .abt__img {
    transform: scale(1.04);
  }

  /* Badge flotante */
  .abt__badge {
    position: absolute;
    bottom: 28px;
    right: -20px;
    width: 110px;
    height: 110px;
    background: #1a1a18;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.18);
  }
  .abt__badge-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 38px;
    font-weight: 300;
    color: #f0ebe2;
    line-height: 1;
  }
  .abt__badge-label {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240,235,226,0.55);
    text-align: center;
    line-height: 1.4;
  }

  /* Línea decorativa lateral con texto rotado */
  .abt__side-line {
    position: absolute;
    left: -36px;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: center;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: rgba(26,26,24,0.25);
    text-transform: uppercase;
  }

  /* ── Contenido ───────────────────────────────── */
  .abt__content {
    display: flex;
    flex-direction: column;
  }

  .abt__label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.45);
    margin-bottom: 28px;
  }
  .abt__label-line {
    display: block;
    width: 32px;
    height: 1px;
    background: rgba(26,26,24,0.3);
    flex-shrink: 0;
  }

  .abt__title {
    font-size: clamp(36px, 4vw, 64px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #1a1a18;
    margin: 0 0 36px 0;
  }

  .abt__text {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.8;
    color: rgba(26,26,24,0.6);
    margin: 0 0 16px 0;
  }

  /* ── Stats ───────────────────────────────────── */
  .abt__stats {
    display: flex;
    gap: 0;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid rgba(26,26,24,0.1);
  }

  .abt__stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    padding-right: 24px;
  }
  .abt__stat + .abt__stat {
    padding-left: 24px;
    padding-right: 24px;
    border-left: 1px solid rgba(26,26,24,0.1);
  }
  .abt__stat:last-child { padding-right: 0; }

  .abt__stat-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 44px;
    font-weight: 300;
    color: #1a1a18;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .abt__stat-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(26,26,24,0.45);
  }

  /* ── CTA ─────────────────────────────────────── */
  .abt__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 52px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1a1a18;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1.5px solid rgba(26,26,24,0.25);
    transition: gap 0.3s ease, border-color 0.3s;
    align-self: flex-start;
  }
  .abt__cta:hover {
    gap: 18px;
    border-color: #1a1a18;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1024px) {
    .abt__inner {
      grid-template-columns: 1fr;
      gap: 56px;
      padding: 0 32px;
    }
    .abt__img { height: 460px; }
    .abt__side-line { display: none; }
    .abt__badge { right: 16px; bottom: 16px; }
  }

  @media (max-width: 640px) {
    .abt { padding: 80px 0 100px; }
    .abt__inner { padding: 0 20px; gap: 40px; }
    .abt__img { height: 360px; }
    .abt__title { font-size: clamp(30px, 9vw, 44px); }
    .abt__stats { gap: 0; }
    .abt__stat-num { font-size: 36px; }
    .abt__badge { width: 90px; height: 90px; }
    .abt__badge-num { font-size: 30px; }
  }
</style>