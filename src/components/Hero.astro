---
/**
 * HERO — Elysian Aromas
 * Layout Essentia: título enorme top-left, producto + mano centrados,
 * texto derecha, marca gigante de fondo.
 * Paleta: oscura dorada de Elysian (#0a0906 bg, #c9a96e gold, #f5efe6 cream)
 */
---

<section class="hero">

  <!-- Marca gigante de fondo -->
  <div class="hero__brand-bg" aria-hidden="true">Elysian</div>

  <!-- Título principal — top left -->
  <div class="hero__title-block">
    <h1 class="hero__title">
      Huevos<br />
      snt<br />
      <em>revealed.</em>
    </h1>
    <div class="hero__proof">
      <div class="hero__avatars">
        <span class="hero__av av1"></span>
        <span class="hero__av av2"></span>
        <span class="hero__av av3"></span>
        <span class="hero__av av4"></span>
      </div>
      <div class="hero__stars-wrap">
        <span class="hero__stars">★★★★★</span>
        <span class="hero__reviews-label">2,500+ Happy Clients</span>
      </div>
    </div>
  </div>

  <!-- Texto derecha -->
  <div class="hero__side-text">
    We craft rare perfumes<br />
    that strip away the<br />
    unnecessary to reveal<br />
    what truly endures.
    <a href="/coleccion" class="hero__cta">
      Explore Collection
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    </a>
  </div>

  <!-- Visual: producto + mano -->
  <div class="hero__visual">
    <div class="hero__product-wrap">
      <div class="hero__product-glow"></div>
      <img
        class="hero__product-img"
        src="https://framerusercontent.com/images/XzpHmYtrKpOC2dXQ7lCieJQH90.png"
        alt="Elysian Perfume"
      />
    </div>
    <div class="hero__hand-wrap">
      <img
        class="hero__hand-img"
        src="https://framerusercontent.com/images/wBo5lTi5xGCI92q80tKg9ywiQ4.png"
        alt=""
        aria-hidden="true"
      />
    </div>
  </div>

</section>

<style>
  /* ─── PALETA ELYSIAN ──────────────────────────── */
  .hero {
    --bg:        #ffffff;
    --cream:     #f5efe6;
    --gold:      #c9a96e;
    --gold-dim:  rgba(201,169,110,0.12);
    --muted:     rgba(245,239,230,0.38);
    --brand-bg:  rgba(201,169,110,0.06);
    --serif:     'Cormorant Garamond', Georgia, serif;
    --sans:      'Montserrat', sans-serif;
  }

  /* ─── BASE ────────────────────────────────────── */
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: var(--bg);
    overflow: hidden;
  }

  /* ─── MARCA FONDO ─────────────────────────────── */
  .hero__brand-bg {
    position: absolute;
    bottom: -0.07em;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(120px, 20vw, 300px);
    letter-spacing: -0.02em;
    color: var(--brand-bg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    line-height: 1;
    /* Texto con stroke dorado tenue como en el sitio actual */
    -webkit-text-stroke: 1px rgba(201,169,110,0.08);
  }

  /* ─── TÍTULO TOP LEFT ─────────────────────────── */
  .hero__title-block {
    position: absolute;
    top: 80px;
    left: 48px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 460px;
  }

  .hero__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 6vw, 90px);
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--cream);
    margin: 0;
  }
  .hero__title em {
    font-style: italic;
    color: var(--gold);
  }

  /* ─── SOCIAL PROOF ────────────────────────────── */
  .hero__proof {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero__avatars {
    display: flex;
  }
  .hero__av {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid rgba(201,169,110,0.25);
    margin-right: -9px;
    display: block;
  }
  .av1 { background: rgba(201,169,110,0.30); }
  .av2 { background: rgba(201,169,110,0.22); }
  .av3 { background: rgba(201,169,110,0.15); }
  .av4 { background: rgba(201,169,110,0.08); }

  .hero__stars-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
  }
  .hero__stars {
    color: var(--gold);
    font-size: 13px;
    letter-spacing: 2px;
  }
  .hero__reviews-label {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ─── TEXTO DERECHA ───────────────────────────── */
  .hero__side-text {
    position: absolute;
    right: 48px;
    top: 50%;
    transform: translateY(-38%);
    z-index: 2;
    font-family: var(--serif);
    font-size: clamp(15px, 1.5vw, 22px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.75;
    color: var(--cream);
    opacity: 0.6;
    text-align: right;
    max-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    font-family: var(--sans);
    font-size: 9px;
    font-style: normal;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 1;
    border-bottom: 1px solid rgba(201,169,110,0.25);
    padding-bottom: 6px;
    text-decoration: none;
    transition: gap 0.3s, border-color 0.3s;
    width: fit-content;
    margin-left: auto;
  }
  .hero__cta:hover {
    gap: 16px;
    border-color: var(--gold);
  }

  /* ─── VISUAL (producto + mano) ────────────────── */
  .hero__visual {
    position: absolute;
    left: 50%;
    transform: translateX(-48%);
    top: 0;
    bottom: 0;
    width: clamp(300px, 40vw, 600px);
    z-index: 1;
    pointer-events: none;
  }

  /* Producto flotando — parte superior del visual */
  .hero__product-wrap {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: floatPerfume 7s ease-in-out infinite;
    z-index: 3;
  }
  .hero__product-img {
    width: clamp(180px, 24vw, 360px);
    filter:
      drop-shadow(0 60px 80px rgba(201,169,110,0.18))
      drop-shadow(0 10px 30px rgba(0,0,0,0.6));
  }
  .hero__product-glow {
    position: absolute;
    bottom: -16px;
    left: 50%;
    transform: translateX(-50%);
    width: 55%;
    height: 24px;
    background: radial-gradient(ellipse, rgba(201,169,110,0.22), transparent 70%);
    filter: blur(10px);
    z-index: 2;
  }

  /* Mano desde abajo */
  .hero__hand-wrap {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 110%;
    z-index: 2;
  }
  .hero__hand-img {
    width: 100%;
    display: block;
    mask-image: linear-gradient(to top, black 55%, transparent 95%);
    -webkit-mask-image: linear-gradient(to top, black 55%, transparent 95%);
  }

  /* ─── ANIMACIONES ─────────────────────────────── */
  @keyframes floatPerfume {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(-22px); }
  }

  /* ─── RESPONSIVE ──────────────────────────────── */
  @media (max-width: 960px) {
    .hero__title-block { left: 32px; top: 90px; }
    .hero__side-text   { right: 24px; font-size: 14px; max-width: 200px; }
    .hero__visual      { width: clamp(260px, 50vw, 460px); }
  }

  @media (max-width: 640px) {
    .hero__title-block {
      position: relative;
      top: auto; left: auto;
      padding: 96px 24px 0;
    }
    .hero__title { font-size: clamp(38px, 10vw, 56px); }

    .hero__side-text {
      position: relative;
      right: auto; top: auto; transform: none;
      padding: 20px 24px 0;
      text-align: left;
      font-size: 15px;
      max-width: 100%;
    }
    .hero__cta { margin-left: 0; justify-content: flex-start; }

    .hero__visual {
      position: relative;
      left: auto; top: auto;
      transform: none;
      width: 100%;
      height: 65vh;
      margin-top: -40px;
    }

    .hero__brand-bg { font-size: 25vw; }
  }
</style>