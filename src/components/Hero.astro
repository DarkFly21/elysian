---
/**
 * HERO — Elysian Aromas
 * Composición: perfume flotando encima de la mano, todo centrado.
 */
---

<section class="hero" id="hero">

  <div class="hero__brand-bg" aria-hidden="true">Elysian</div>

  <!-- Título top-left -->
  <div class="hero__title-block">
    <h1 class="hero__title">Your finest scent revealed.</h1>
    <div class="hero__proof">
      <div class="hero__avatars">
        <img class="hero__av" src="https://i.pravatar.cc/40?img=47" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=44" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=41" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=48" alt="" />
      </div>
      <div class="hero__stars">★★★★★</div>
      <div class="hero__reviews-label">2500+ Happy Customers</div>
    </div>
  </div>

  <!-- Texto derecha -->
  <div class="hero__side-text">
    We strip away the unnecessary<br />to focus on what truly endures.
  </div>

  <!--
    COMPOSICIÓN CENTRAL:
    Un solo contenedor centrado en el viewport.
    Dentro: perfume arriba, mano abajo solapando.
    La mano empieza recortada abajo y sube con scroll.
  -->
  <div class="hero__stage">

    <!-- Perfume: PNG con blend para eliminar fondo blanco -->
    <img
      class="hero__perfume"
      src="https://www.destinodebelleza.es/assets/images/product_images/700x700_ADGH_Profondo.png"
      alt="Elysian Perfume"
    />

    <!-- Mano: sube desde abajo con scroll -->
    <img
      class="hero__hand"
      id="heroHand"
      src="https://framerusercontent.com/images/wBo5lTi5xGCI92q80tKg9ywiQ4.png"
      alt=""
      aria-hidden="true"
    />

  </div>

</section>

<style>
  .hero {
    --bg:    #f0ebe2;
    --text:  #1a1a18;
    --muted: rgba(26,26,24,0.45);
    --brand: rgba(26,26,24,0.055);
    --sans:  'Montserrat', system-ui, sans-serif;
  }

  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: var(--bg);
    overflow: hidden;
  }

  /* ── Marca fondo ─────────────────────────────── */
  .hero__brand-bg {
    position: absolute;
    bottom: -0.06em;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(110px, 19vw, 280px);
    letter-spacing: -0.02em;
    color: var(--brand);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    line-height: 1;
  }

  /* ── Título top-left ─────────────────────────── */
  .hero__title-block {
    position: absolute;
    top: 160px;
    left: 44px;
    z-index: 3;
    max-width: 420px;
  }
  .hero__title {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(40px, 5.8vw, 88px);
    line-height: 1.0;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0 0 24px 0;
  }
  .hero__proof { display: flex; flex-direction: column; gap: 5px; }
  .hero__avatars { display: flex; margin-bottom: 6px; }
  .hero__av {
    width: 34px; height: 34px;
    border-radius: 50%;
    border: 2.5px solid var(--bg);
    margin-right: -10px;
    object-fit: cover;
  }
  .hero__stars { font-size: 14px; letter-spacing: 1px; color: var(--text); }
  .hero__reviews-label {
    font-family: var(--sans);
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.05em; color: var(--muted);
  }

  /* ── Texto derecha ───────────────────────────── */
  .hero__side-text {
    position: absolute;
    right: 48px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    font-family: var(--sans);
    font-size: clamp(14px, 1.4vw, 20px);
    font-weight: 400;
    line-height: 1.65;
    color: var(--text);
    text-align: right;
    max-width: 260px;
  }

  /* ── STAGE: contenedor central de la composición ── */
  .hero__stage {
    position: absolute;
    /*
      Centrado horizontal.
      Verticalmente: el stage ocupa TODO el alto del hero.
      Los elementos dentro se posicionan relativos al stage.
    */
    left: 50%;
    top: 0;
    bottom: 0;
    transform: translateX(-50%);
    width: clamp(320px, 42vw, 600px);
    z-index: 2;
    pointer-events: none;
    /* Sin overflow para que la mano pueda salir por abajo */
    overflow: visible;
  }

  /* Perfume:
     - Centrado en el stage horizontalmente
     - Verticalmente: aprox 30–55% del hero (centro-alto)
     - Flota con animación
  */
  .hero__perfume {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateX(-50%) translateY(-70%);
    width: clamp(280px, 34vw, 500px);
    /* mix-blend-mode funde el fondo blanco del JPG con el crema */
    mix-blend-mode: multiply;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,0.12));
    animation: floatPerfume 7s ease-in-out infinite;
    z-index: 2;
  }

  /* Mano:
     - Centrada en el stage horizontalmente
     - Pegada al fondo del stage, sobresale hacia abajo
     - JS la mueve de translateY(35%) → translateY(-5%)
  */
  .hero__hand {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%) translateY(35%);
    width: 105%;
    z-index: 3;
    will-change: transform;
  }

  @keyframes floatPerfume {
    0%, 100% { transform: translateX(-50%) translateY(-70%); }
    50%       { transform: translateX(-50%) translateY(calc(-70% - 16px)); }
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 960px) {
    .hero__title-block { left: 28px; top: 80px; max-width: 360px; }
    .hero__side-text   { right: 20px; font-size: 13px; max-width: 200px; }
    .hero__stage       { width: clamp(260px, 50vw, 480px); }
  }
  @media (max-width: 640px) {
    .hero__title-block { position: relative; top: auto; left: auto; padding: 88px 24px 0; }
    .hero__title       { font-size: clamp(34px, 9vw, 50px); }
    .hero__side-text   { position: relative; right: auto; top: auto; transform: none; padding: 16px 24px 0; text-align: left; max-width: 100%; }
    .hero__stage       { position: relative; left: auto; transform: none; width: 100%; height: 65vh; }
    .hero__brand-bg    { font-size: 25vw; }
  }
</style>

<script is:inline>
(function () {
  function init() {
    var hand = document.getElementById('heroHand');
    var hero = document.getElementById('hero');
    if (!hand || !hero) return;

    function update() {
      var scrollY  = window.pageYOffset || document.documentElement.scrollTop;
      var heroH    = hero.offsetHeight;
      var progress = Math.min(scrollY / (heroH * 0.6), 1);
      // mano: 35% → -5% (sube y llega debajo del perfume)
      var offset   = 35 - (progress * 40);
      hand.style.transform = 'translateX(-50%) translateY(' + offset + '%)';
    }

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>