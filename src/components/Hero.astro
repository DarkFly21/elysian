---
/**
 * HERO — Elysian Aromas
 * Elementos grandes para verse bien al 140% zoom
 * Mobile: layout vertical limpio
 */
---

<section class="hero" id="hero">

  <div class="hero__brand-bg" aria-hidden="true">Elysian</div>

  <div class="hero__title-block">
    <h1 class="hero__title">Tu mejor<br/>fragancia,<br/>revelada.</h1>
    <div class="hero__proof">
      <div class="hero__avatars">
        <img class="hero__av" src="https://i.pravatar.cc/40?img=47" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=44" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=41" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=48" alt="" />
      </div>
      <div class="hero__stars">★★★★★</div>
      <div class="hero__reviews-label">+2,500 clientes satisfechos</div>
    </div>
  </div>

  <div class="hero__side-text">
    Eliminamos lo innecesario<br />para enfocarnos en<br />lo que verdaderamente perdura.
  </div>

  <div class="hero__stage">
    <img
      class="hero__perfume"
      id="heroPerfume"
      src="https://www.destinodebelleza.es/assets/images/product_images/700x700_ADGH_Profondo.png"
      alt="Perfume Elysian"
    />
    <img
      class="hero__hand"
      id="heroHand"
      src="https://framerusercontent.com/images/wBo5lTi5xGCI92q80tKg9ywiQ4.png"
      alt=""
      aria-hidden="true"
    />
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Descubre más</span>
    <div class="hero__scroll-line"></div>
  </div>

</section>

<style>
  .hero {
    --bg:    #f0ebe2;
    --text:  #1a1a18;
    --muted: rgba(26,26,24,0.45);
    --brand: rgba(26,26,24,0.055);
    --sans:  'Montserrat', system-ui, sans-serif;
  }

  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Marca fondo ─────────────────────────────── */
  .hero__brand-bg {
    position: absolute;
    bottom: -0.05em;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 900;
    font-size: clamp(120px, 22vw, 340px);
    letter-spacing: -0.02em;
    color: var(--brand);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    line-height: 1;
  }

  /* ── Título izquierda ────────────────────────── */
  .hero__title-block {
    position: absolute;
    top: 50%;
    left: 52px;
    transform: translateY(-50%);
    z-index: 10;
    max-width: 420px;
  }
  .hero__title {
    font-family: var(--sans);
    font-weight: 900;
    font-size: clamp(44px, 6.5vw, 96px);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0 0 32px 0;
  }
  .hero__proof        { display: flex; flex-direction: column; gap: 6px; }
  .hero__avatars      { display: flex; margin-bottom: 4px; }
  .hero__av {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 2.5px solid var(--bg);
    margin-right: -10px;
    object-fit: cover;
  }
  .hero__stars        { font-size: 15px; letter-spacing: 2px; color: var(--text); margin-top: 4px; }
  .hero__reviews-label {
    font-family: var(--sans);
    font-size: 12px; font-weight: 500;
    letter-spacing: 0.06em; color: var(--muted);
  }

  /* ── Texto derecha ───────────────────────────── */
  .hero__side-text {
    position: absolute;
    right: 52px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    font-family: var(--sans);
    font-size: clamp(14px, 1.4vw, 20px);
    font-weight: 400;
    line-height: 1.7;
    color: var(--text);
    text-align: right;
    max-width: 260px;
  }

  /* ── Stage central ───────────────────────────── */
  .hero__stage {
    position: relative;
    width: clamp(340px, 44vw, 640px);
    height: 88vh;
    z-index: 5;
    overflow: visible;
    pointer-events: none;
  }

  .hero__perfume {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateX(-50%) translateY(-55%);
    width: clamp(280px, 36vw, 540px);
    mix-blend-mode: multiply;
    filter: drop-shadow(0 28px 56px rgba(0,0,0,0.14));
    animation: floatPerfume 6s ease-in-out infinite;
    z-index: 6;
    will-change: transform;
  }

  .hero__hand {
    position: absolute;
    left: 50%;
    bottom: -8%;
    transform: translateX(-50%) translateY(60%);
    width: 130%;
    z-index: 7;
    will-change: transform;
  }

  @keyframes floatPerfume {
    0%, 100% { transform: translateX(-50%) translateY(-55%); }
    50%       { transform: translateX(-50%) translateY(calc(-55% - 18px)); }
  }

  /* ── Scroll hint ─────────────────────────────── */
  .hero__scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: var(--sans);
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(26,26,24,0.3);
    text-transform: uppercase;
    text-align: center;
  }
  .hero__scroll-line {
    width: 1px; height: 40px;
    background: rgba(26,26,24,0.25);
    margin: 8px auto 0;
  }

  /* ── Tablet ──────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero__title-block { left: 32px; max-width: 320px; }
    .hero__title       { font-size: clamp(40px, 5.5vw, 72px); }
    .hero__side-text   { right: 24px; font-size: 13px; max-width: 190px; }
    .hero__stage       { width: clamp(280px, 42vw, 480px); }
    .hero__perfume     { width: clamp(220px, 32vw, 400px); }
  }

  /* ── Mobile ──────────────────────────────────── */
  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
      align-items: flex-start;
    }

    .hero__title-block {
      position: absolute;
      top: 76px;
      left: 24px;
      right: 24px;
      transform: none;
      max-width: none;
    }
    .hero__title {
      font-size: clamp(40px, 12vw, 58px);
      margin-bottom: 14px;
    }
    .hero__av { width: 30px; height: 30px; }

    .hero__side-text { display: none; }

    .hero__stage {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      height: 55vh;
    }

    .hero__perfume {
      width: clamp(180px, 62vw, 300px);
      top: 5%;
      left: 50%;
      transform: translateX(-50%) translateY(0%);
      animation: floatPerfumeMobile 6s ease-in-out infinite;
    }

    .hero__hand {
      width: 140%;
      bottom: -4%;
      left: 50%;
      transform: translateX(-50%) translateY(52%);
    }

    .hero__brand-bg  { font-size: 30vw; }
    .hero__scroll-hint { bottom: 12px; }
  }

  @keyframes floatPerfumeMobile {
    0%, 100% { transform: translateX(-50%) translateY(0%); }
    50%       { transform: translateX(-50%) translateY(-10px); }
  }
</style>

<script is:inline>
(function () {
  function init() {
    var perfume = document.getElementById('heroPerfume');
    var hand    = document.getElementById('heroHand');
    var hero    = document.getElementById('hero');
    if (!perfume || !hand || !hero) return;

    var ticking = false;

    function isMobile() { return window.innerWidth <= 640; }

    function update() {
      var scrollY  = window.pageYOffset || document.documentElement.scrollTop;
      var heroH    = hero.offsetHeight;
      var progress = Math.min(Math.max(scrollY / (heroH * 0.65), 0), 1);

      if (isMobile()) {
        var handY = 52 - progress * 38;
        hand.style.transform = 'translateX(-50%) translateY(' + handY + '%)';
        if (progress > 0) {
          perfume.style.animationPlayState = 'paused';
          var pfY = progress * 15;
          perfume.style.transform = 'translateX(-50%) translateY(' + pfY + '%)';
        } else {
          perfume.style.animationPlayState = 'running';
          perfume.style.transform = '';
        }
      } else {
        var pfY = -55 + progress * 39;
        if (progress > 0) {
          perfume.style.animationPlayState = 'paused';
          perfume.style.transform = 'translateX(-50%) translateY(' + pfY + '%)';
        } else {
          perfume.style.animationPlayState = 'running';
          perfume.style.transform = '';
        }
        var handY = 60 - progress * 52;
        hand.style.transform = 'translateX(-50%) translateY(' + handY + '%)';
      }

      ticking = false;
    }

    update();
    window.addEventListener('scroll', function () {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>