---
/**
 * HERO — Elysian Aromas
 * Perfume baja y mano sube con scroll hasta encontrarse.
 * Ajustado para verse bien al 120% de zoom.
 */
---

<section class="hero" id="hero">

  <div class="hero__brand-bg" aria-hidden="true">Elysian</div>

  <!-- Título izquierda -->
  <div class="hero__title-block">
    <h1 class="hero__title">Tu mejor<br/>fragancia,<br/>revelada.</h1>
    <div class="hero__proof">
      <div class="hero__avatars">
        <img class="hero__av" src="https://i.pravatar.cc/40?img=47" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=44" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=41" alt="" />
        <img class="hero__av" src="https://i.pravatar.cc/40?img=48" alt="" />
      </div>
      <div class="hero__stars">★★★★★</div>
      <div class="hero__reviews-label">+2,500 clientes satisfechos</div>
    </div>
  </div>

  <!-- Texto derecha -->
  <div class="hero__side-text">
    Eliminamos lo innecesario<br />para enfocarnos en<br />lo que verdaderamente perdura.
  </div>

  <!-- Composición central -->
  <div class="hero__stage">

    <img
      class="hero__perfume"
      id="heroPerfume"
      src="https://www.destinodebelleza.es/assets/images/product_images/700x700_ADGH_Profondo.png"
      alt="Perfume Elysian"
    />

    <img
      class="hero__hand"
      id="heroHand"
      src="https://framerusercontent.com/images/wBo5lTi5xGCI92q80tKg9ywiQ4.png"
      alt=""
      aria-hidden="true"
    />

  </div>

  <!-- Indicador scroll -->
  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Descubre más</span>
    <div class="hero__scroll-line"></div>
  </div>

</section>

<style>
  .hero {
    --bg:    #f0ebe2;
    --text:  #1a1a18;
    --muted: rgba(26,26,24,0.45);
    --brand: rgba(26,26,24,0.055);
    --sans:  'Montserrat', system-ui, sans-serif;
  }

  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Marca fondo ─────────────────────────────── */
  .hero__brand-bg {
    position: absolute;
    bottom: -0.05em;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 900;
    /* reducido para que no tape demasiado al 120% */
    font-size: clamp(80px, 14vw, 200px);
    letter-spacing: -0.02em;
    color: var(--brand);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    line-height: 1;
  }

  /* ── Título izquierda ────────────────────────── */
  .hero__title-block {
    position: absolute;
    top: 50%;
    left: 44px;
    transform: translateY(-50%);
    z-index: 10;
    max-width: 340px;
  }
  .hero__title {
    font-family: var(--sans);
    font-weight: 900;
    /* más compacto para caber bien al 120% */
    font-size: clamp(30px, 4vw, 60px);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0 0 22px 0;
  }
  .hero__proof        { display: flex; flex-direction: column; gap: 5px; }
  .hero__avatars      { display: flex; margin-bottom: 4px; }
  .hero__av {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 2px solid var(--bg);
    margin-right: -8px;
    object-fit: cover;
  }
  .hero__stars        { font-size: 12px; letter-spacing: 2px; color: var(--text); margin-top: 2px; }
  .hero__reviews-label {
    font-family: var(--sans);
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.06em; color: var(--muted);
  }

  /* ── Texto derecha ───────────────────────────── */
  .hero__side-text {
    position: absolute;
    right: 44px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    font-family: var(--sans);
    font-size: clamp(11px, 1vw, 15px);
    font-weight: 400;
    line-height: 1.7;
    color: var(--text);
    text-align: right;
    max-width: 200px;
  }

  /* ── Stage central ───────────────────────────── */
  .hero__stage {
    position: relative;
    /* reducido para que quepa al 120% */
    width: clamp(240px, 30vw, 440px);
    height: 82vh;
    z-index: 5;
    overflow: visible;
    pointer-events: none;
  }

  /* Perfume */
  .hero__perfume {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateX(-50%) translateY(-58%);
    width: clamp(180px, 22vw, 340px);
    mix-blend-mode: multiply;
    filter: drop-shadow(0 20px 36px rgba(0,0,0,0.13));
    animation: floatPerfume 6s ease-in-out infinite;
    z-index: 6;
    will-change: transform;
  }

  /* Mano: reposicionada más al centro y visible desde el inicio */
  .hero__hand {
    position: absolute;
    left: 52%;                      /* leve offset a la derecha */
    bottom: -5%;                    /* empieza más arriba que antes */
    transform: translateX(-50%) translateY(55%);
    width: 105%;
    z-index: 7;
    will-change: transform;
  }

  @keyframes floatPerfume {
    0%, 100% { transform: translateX(-50%) translateY(-58%); }
    50%       { transform: translateX(-50%) translateY(calc(-58% - 12px)); }
  }

  /* ── Indicador scroll ────────────────────────── */
  .hero__scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: var(--sans);
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(26,26,24,0.3);
    text-transform: uppercase;
    text-align: center;
  }
  .hero__scroll-line {
    width: 1px;
    height: 36px;
    background: rgba(26,26,24,0.25);
    margin: 8px auto 0;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 960px) {
    .hero__title-block { left: 24px; max-width: 260px; }
    .hero__side-text   { right: 16px; font-size: 11px; max-width: 160px; }
    .hero__stage       { width: clamp(220px, 42vw, 380px); }
  }
  @media (max-width: 640px) {
    .hero__title-block {
      position: absolute;
      top: 80px; left: 20px; right: 20px;
      transform: none; max-width: none;
    }
    .hero__title     { font-size: clamp(30px, 9vw, 44px); }
    .hero__side-text { display: none; }
    .hero__stage     { width: 88%; height: 58vh; }
    .hero__brand-bg  { font-size: 26vw; }
  }
</style>

<script is:inline>
(function () {
  function init() {
    var perfume = document.getElementById('heroPerfume');
    var hand    = document.getElementById('heroHand');
    var hero    = document.getElementById('hero');
    if (!perfume || !hand || !hero) return;

    var pfBaseY = -58;

    var ticking = false;

    function update() {
      var scrollY  = window.pageYOffset || document.documentElement.scrollTop;
      var heroH    = hero.offsetHeight;
      var progress = Math.min(Math.max(scrollY / (heroH * 0.65), 0), 1);

      // Perfume baja: -58% → -22%
      var pfY = pfBaseY + progress * 36;
      if (progress > 0) {
        perfume.style.animationPlayState = 'paused';
        perfume.style.transform = 'translateX(-50%) translateY(' + pfY + '%)';
      } else {
        perfume.style.animationPlayState = 'running';
        perfume.style.transform = '';
      }

      // Mano sube: 55% → 8%
      var handY = 55 - progress * 47;
      hand.style.transform = 'translateX(-50%) translateY(' + handY + '%)';

      ticking = false;
    }

    update();
    window.addEventListener('scroll', function () {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>