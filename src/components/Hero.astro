---
/**
 * COMPONENTE: Hero
 * Diseño fiel al template Elysian de Framer
 * Fondo fotográfico + frasco flotante + texto "divine allure"
 */
---

<section class="hero">
  <!-- Fondo fotográfico -->
  <div class="hero__bg">
    <img
      src="https://framerusercontent.com/images/8eq7qmkLvK4orUvTGKaJXCo8L1I.png"
      alt=""
      aria-hidden="true"
      class="hero__bg-img"
    />
    <div class="hero__bg-overlay"></div>
  </div>

  <!-- Texto decorativo fondo -->
  <div class="hero__wordmark" aria-hidden="true">divine<br/>allure</div>

  <!-- Frasco flotante -->
  <div class="hero__bottle">
    <img
      src="https://framerusercontent.com/images/XzpHmYtrKpOC2dXQ7lCieJQH90.png"
      alt="Elysian perfume"
      loading="eager"
    />
  </div>

  <!-- Contenido -->
  <div class="hero__content container">
    <p class="hero__eyebrow">Est. 2024</p>
    <h1 class="hero__title">
      Huevos<br />
      to Elysian<br />
      Aromas
    </h1>
    <p class="hero__sub">
      A luxury perfume company that creates<br />
      unforgettable scents, leaving an unforgettable impression.
    </p>
    <div class="hero__actions">
      <a href="/coleccion" class="btn-gold">Explore Collection</a>
      <a href="/nosotros" class="btn-line">
        <span class="btn-line__dash"></span>
        Our Story
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll">
    <div class="hero__scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* Fondo fotográfico */
.hero__bg {
  position: absolute;
  inset: 0;
}
.hero__bg-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 30%;
  filter: brightness(0.35);
}
.hero__bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg,
    rgba(10,9,6,0.7) 0%,
    rgba(10,9,6,0.2) 60%,
    rgba(10,9,6,0.5) 100%
  );
}

/* Texto decorativo grande */
.hero__wordmark {
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--f-serif);
  font-size: clamp(100px, 14vw, 220px);
  font-weight: 300;
  font-style: italic;
  line-height: 0.85;
  color: transparent;
  -webkit-text-stroke: 1px rgba(201,169,110,0.12);
  pointer-events: none;
  user-select: none;
  white-space: nowrap;
  text-align: right;
  z-index: 1;
}

/* Frasco */
.hero__bottle {
  position: absolute;
  right: 8%;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  animation: float 6s ease-in-out infinite;
}
.hero__bottle img {
  width: clamp(200px, 22vw, 380px);
  filter: drop-shadow(0 40px 80px rgba(201,169,110,0.2));
}

/* Contenido */
.hero__content {
  position: relative;
  z-index: 3;
  width: 100%;
  padding-top: 80px;
}
.hero__eyebrow {
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--c-gold);
  margin-bottom: 28px;
}
.hero__title {
  font-size: clamp(48px, 7vw, 100px);
  font-weight: 300;
  color: var(--c-cream);
  line-height: 1.0;
  margin-bottom: 24px;
}
.hero__sub {
  font-size: 13px;
  line-height: 1.8;
  color: var(--c-cream);
  opacity: 0.6;
  max-width: 360px;
  margin-bottom: 48px;
}
.hero__actions {
  display: flex;
  align-items: center;
  gap: 32px;
  flex-wrap: wrap;
}

/* Botones */
.btn-gold {
  display: inline-flex;
  align-items: center;
  background: var(--c-gold);
  color: var(--c-bg);
  padding: 15px 36px;
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-family: var(--f-sans);
  font-weight: 500;
  transition: background 0.3s, transform 0.2s;
}
.btn-gold:hover {
  background: var(--c-gold-light);
  transform: translateY(-2px);
}

.btn-line {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.6;
  transition: opacity 0.3s, gap 0.3s;
}
.btn-line__dash {
  width: 28px;
  height: 1px;
  background: currentColor;
}
.btn-line:hover { opacity: 1; gap: 18px; }

/* Scroll indicator */
.hero__scroll {
  position: absolute;
  bottom: 40px;
  left: 48px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  z-index: 3;
}
.hero__scroll-line {
  width: 1px;
  height: 50px;
  background: linear-gradient(to bottom, var(--c-gold), transparent);
  animation: float 2s ease-in-out infinite;
}
.hero__scroll span {
  font-size: 9px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--c-gold);
  writing-mode: vertical-rl;
  opacity: 0.5;
}

/* Responsive */
@media (max-width: 768px) {
  .hero__bottle { display: none; }
  .hero__wordmark { display: none; }
  .hero__scroll { display: none; }
  .hero__content { padding-top: 120px; }
  .hero__sub { max-width: 100%; }
}
</style>