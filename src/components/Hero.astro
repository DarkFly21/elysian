---
/**
 * HERO — Elysian Aromas
 * Estilo Essentia: fondo oscuro, título enorme top-left,
 * producto flotando centrado, texto derecha, marca gigante de fondo
 */
---

<section class="hero">

  <!-- Marca gigante de fondo -->
  <div class="hero__bg-brand" aria-hidden="true">Elysian</div>

  <!-- Grid principal -->
  <div class="hero__inner">

    <!-- Columna izquierda — Título + social proof -->
    <div class="hero__col hero__col--left">
      <h1 class="hero__title">
        Your finest<br/>
        scent<br/>
        <em>revealed.</em>
      </h1>
      <div class="hero__social-proof">
        <div class="hero__avatars">
          <div class="hero__avatar av1"></div>
          <div class="hero__avatar av2"></div>
          <div class="hero__avatar av3"></div>
          <div class="hero__avatar av4"></div>
        </div>
        <div class="hero__stars-row">★★★★★</div>
        <span class="hero__reviews">2,500+ Happy Clients</span>
      </div>
    </div>

    <!-- Columna centro — Producto -->
    <div class="hero__col hero__col--center">
      <div class="hero__product-wrap">
        <div class="hero__product-glow"></div>
        <img
          class="hero__product-img"
          src="https://framerusercontent.com/images/XzpHmYtrKpOC2dXQ7lCieJQH90.png"
          alt="Elysian — Fragrance"
        />
      </div>
    </div>

    <!-- Columna derecha — Descripción + CTA -->
    <div class="hero__col hero__col--right">
      <p class="hero__desc">
        We craft rare perfumes<br/>
        that strip away the<br/>
        unnecessary to reveal<br/>
        what truly endures.
      </p>
      <a href="/coleccion" class="hero__btn">
        <span>Explore Collection</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll-hint">
    <div class="hero__scroll-track"><div class="hero__scroll-thumb"></div></div>
    <span>Scroll</span>
  </div>

  <!-- Badge circular -->
  <div class="hero__badge">
    <svg class="hero__badge-ring" viewBox="0 0 80 80">
      <path id="badgePath" d="M 40,40 m -28,0 a 28,28 0 1,1 56,0 a 28,28 0 1,1 -56,0" fill="none"/>
      <text font-size="7" fill="rgba(201,169,110,0.5)" font-family="Montserrat,sans-serif" letter-spacing="3">
        <textPath href="#badgePath">✦ LUXURY PERFUME ✦ EST. 2024 ✦</textPath>
      </text>
    </svg>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    background: #0a0906;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Marca gigante de fondo */
  .hero__bg-brand {
    position: absolute;
    bottom: -0.06em;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(110px, 18vw, 280px);
    font-weight: 300;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201,169,110,0.08);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    line-height: 1;
  }

  /* Grid 3 columnas */
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 100vh;
    padding: 100px 64px 80px;
    gap: 0;
  }

  .hero__col {
    display: flex;
    flex-direction: column;
  }

  .hero__col--left {
    justify-content: flex-start;
    padding-top: 20px;
    gap: 36px;
  }

  .hero__col--center {
    align-items: center;
    justify-content: center;
    padding: 0 56px;
  }

  .hero__col--right {
    justify-content: center;
    align-items: flex-end;
    text-align: right;
    gap: 28px;
  }

  /* Título */
  .hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 300;
    font-size: clamp(46px, 5.5vw, 88px);
    line-height: 1.0;
    color: #f5ede0;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .hero__title em {
    font-style: italic;
    color: #c9a96e;
  }

  /* Social proof */
  .hero__social-proof {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero__avatars {
    display: flex;
  }
  .hero__avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid rgba(201,169,110,0.3);
    margin-right: -10px;
    background: rgba(201,169,110,0.1);
  }
  .av1 { background: rgba(201,169,110,0.18); }
  .av2 { background: rgba(232,201,138,0.14); }
  .av3 { background: rgba(201,169,110,0.10); }
  .av4 { background: rgba(245,237,224,0.07); }
  .hero__stars-row {
    margin-top: 6px;
    color: #c9a96e;
    font-size: 14px;
    letter-spacing: 2px;
  }
  .hero__reviews {
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f5ede0;
    opacity: 0.3;
  }

  /* Producto */
  .hero__product-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: float 8s ease-in-out infinite;
  }
  .hero__product-img {
    width: clamp(200px, 22vw, 400px);
    filter:
      drop-shadow(0 70px 70px rgba(201,169,110,0.20))
      drop-shadow(0 20px 40px rgba(0,0,0,0.55));
    position: relative;
    z-index: 2;
  }
  .hero__product-glow {
    position: absolute;
    bottom: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 50%;
    height: 24px;
    background: radial-gradient(ellipse, rgba(201,169,110,0.28), transparent 70%);
    filter: blur(10px);
    z-index: 1;
  }

  /* Descripción */
  .hero__desc {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(18px, 1.8vw, 26px);
    font-weight: 300;
    line-height: 1.75;
    color: #f5ede0;
    opacity: 0.65;
    font-style: italic;
    margin: 0;
  }

  /* CTA */
  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c9a96e;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(201,169,110,0.22);
    transition: gap 0.4s ease, border-color 0.3s;
    width: fit-content;
    margin-left: auto;
    text-decoration: none;
  }
  .hero__btn:hover {
    gap: 20px;
    border-color: #c9a96e;
  }

  /* Scroll indicator */
  .hero__scroll-hint {
    position: absolute;
    bottom: 36px;
    left: 64px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 10;
  }
  .hero__scroll-track {
    width: 1px;
    height: 50px;
    background: rgba(201,169,110,0.12);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background: #c9a96e;
    opacity: 0.5;
    animation: scrollDown 2.6s ease-in-out infinite;
  }
  .hero__scroll-hint span {
    font-family: 'Montserrat', sans-serif;
    font-size: 8px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #f5ede0;
    opacity: 0.22;
    writing-mode: vertical-rl;
  }

  /* Badge circular */
  .hero__badge {
    position: absolute;
    bottom: 40px;
    right: 64px;
    width: 80px;
    height: 80px;
    z-index: 10;
    animation: rotateSlow 18s linear infinite;
  }
  .hero__badge-ring {
    width: 80px;
    height: 80px;
  }

  /* Animaciones */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-20px); }
  }
  @keyframes scrollDown {
    0%   { transform: translateY(-100%); opacity: 0; }
    20%  { opacity: 0.6; }
    80%  { opacity: 0.6; }
    100% { transform: translateY(260%); opacity: 0; }
  }
  @keyframes rotateSlow {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr 1fr;
      padding: 100px 40px 80px;
    }
    .hero__col--left   { grid-column: 1; grid-row: 1; }
    .hero__col--center { grid-column: 2; grid-row: 1 / 3; padding: 0 20px; }
    .hero__col--right  { grid-column: 1; grid-row: 2; align-items: flex-start; text-align: left; }
    .hero__btn         { margin-left: 0; }
    .hero__badge       { right: 40px; }
    .hero__scroll-hint { left: 40px; }
  }

  @media (max-width: 640px) {
    .hero__inner {
      grid-template-columns: 1fr;
      padding: 100px 24px 80px;
      text-align: center;
    }
    .hero__col--left   { grid-column: 1; grid-row: 1; align-items: center; }
    .hero__col--center { grid-column: 1; grid-row: 2; padding: 40px 0; }
    .hero__col--right  { grid-column: 1; grid-row: 3; align-items: center; text-align: center; }
    .hero__btn         { margin: 0 auto; }
    .hero__bg-brand    { font-size: 22vw; }
    .hero__badge       { display: none; }
    .hero__scroll-hint { left: 24px; }
  }
</style>