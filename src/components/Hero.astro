---
/**
 * HERO — Estilo minimalista editorial
 * Inspirado en Essentia + SOHub:
 * Tipografía enorme, producto centrado flotando, mucho espacio
 */
---

<section class="hero">

  <!-- Nav hint arriba derecha -->
  <div class="hero__tagline">
    <span>Luxury Fragrance</span>
    <span class="hero__dot">✦</span>
    <span>Est. 2024</span>
  </div>

  <!-- Texto enorme de fondo -->
  <div class="hero__bg-word" aria-hidden="true">Elysian</div>

  <!-- Producto centrado -->
  <div class="hero__product">
    <img
      src="https://framerusercontent.com/images/XzpHmYtrKpOC2dXQ7lCieJQH90.png"
      alt="Elysian Aromas — Fragrance"
    />
    <div class="hero__product-glow"></div>
  </div>

  <!-- Título izquierda -->
  <div class="hero__left">
    <h1 class="hero__title">
      Divine<br/>
      <em>Allure.</em>
    </h1>
    <p class="hero__sub">
      A luxury perfume company<br/>
      that creates unforgettable scents.
    </p>
    <a href="/coleccion" class="hero__cta">
      Explore Collection
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    </a>
  </div>

  <!-- Info derecha -->
  <div class="hero__right">
    <div class="hero__stat">
      <span class="hero__stat-num">12</span>
      <span class="hero__stat-label">Unique<br/>Scents</span>
    </div>
    <div class="hero__stat">
      <span class="hero__stat-num">42</span>
      <span class="hero__stat-label">Rare<br/>Ingredients</span>
    </div>
    <a href="/coleccion" class="hero__shop">
      Shop Now →
    </a>
  </div>

  <!-- Scroll -->
  <div class="hero__scroll">
    <div class="hero__scroll-line"></div>
    <span>Scroll</span>
  </div>

</section>

<style>
.hero {
  position: relative;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  grid-template-rows: auto 1fr auto;
  align-items: center;
  padding: 120px 64px 60px;
  overflow: hidden;
  background: var(--c-bg);
}

/* Tagline arriba centro */
.hero__tagline {
  grid-column: 1 / -1;
  grid-row: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.35;
  margin-bottom: 0;
  padding-bottom: 40px;
}
.hero__dot { color: var(--c-gold); opacity: 0.6; }

/* Texto enorme de fondo */
.hero__bg-word {
  position: absolute;
  bottom: -0.1em;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--f-serif);
  font-size: clamp(120px, 18vw, 280px);
  font-weight: 300;
  color: transparent;
  -webkit-text-stroke: 1px rgba(201,169,110,0.1);
  white-space: nowrap;
  pointer-events: none;
  user-select: none;
  line-height: 1;
  z-index: 0;
  letter-spacing: -0.02em;
}

/* Producto */
.hero__product {
  grid-column: 2;
  grid-row: 2;
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  animation: float 7s ease-in-out infinite;
}
.hero__product img {
  width: clamp(220px, 24vw, 420px);
  filter: drop-shadow(0 60px 100px rgba(201,169,110,0.18))
          drop-shadow(0 20px 40px rgba(0,0,0,0.4));
}
.hero__product-glow {
  position: absolute;
  bottom: -20px;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  height: 20px;
  background: radial-gradient(ellipse, rgba(201,169,110,0.25), transparent 70%);
  filter: blur(8px);
  z-index: -1;
}

/* Izquierda */
.hero__left {
  grid-column: 1;
  grid-row: 2;
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding-right: 40px;
  z-index: 2;
}
.hero__title {
  font-family: var(--f-serif);
  font-size: clamp(52px, 6vw, 90px);
  font-weight: 300;
  color: var(--c-cream);
  line-height: 1.0;
}
.hero__title em {
  font-style: italic;
  color: var(--c-gold);
}
.hero__sub {
  font-size: 13px;
  line-height: 1.8;
  color: var(--c-cream);
  opacity: 0.45;
  max-width: 240px;
}
.hero__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--c-gold);
  border-bottom: 1px solid rgba(201,169,110,0.3);
  padding-bottom: 6px;
  width: fit-content;
  transition: gap 0.3s, border-color 0.3s;
}
.hero__cta:hover { gap: 16px; border-color: var(--c-gold); }

/* Derecha */
.hero__right {
  grid-column: 3;
  grid-row: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 40px;
  padding-left: 40px;
  z-index: 2;
}
.hero__stat {
  display: flex;
  align-items: baseline;
  gap: 12px;
  text-align: right;
}
.hero__stat-num {
  font-family: var(--f-serif);
  font-size: 56px;
  color: var(--c-gold);
  line-height: 1;
  opacity: 0.8;
}
.hero__stat-label {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.4;
  line-height: 1.4;
}
.hero__shop {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.35;
  transition: opacity 0.3s;
}
.hero__shop:hover { opacity: 1; color: var(--c-gold); }

/* Divider decorativo horizontal */
.hero::before {
  content: '';
  position: absolute;
  top: 110px;
  left: 64px;
  right: 64px;
  height: 1px;
  background: rgba(201,169,110,0.08);
  z-index: 1;
}

/* Scroll */
.hero__scroll {
  grid-column: 1 / -1;
  grid-row: 3;
  display: flex;
  align-items: center;
  gap: 16px;
  padding-top: 40px;
  z-index: 2;
}
.hero__scroll-line {
  width: 40px;
  height: 1px;
  background: var(--c-gold);
  opacity: 0.4;
}
.hero__scroll span {
  font-size: 9px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.3;
}

/* Responsive */
@media (max-width: 1024px) {
  .hero {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto auto;
    padding: 100px 40px 60px;
  }
  .hero__tagline { grid-column: 1 / -1; }
  .hero__product { grid-column: 2; grid-row: 2; }
  .hero__left { grid-column: 1; grid-row: 2; padding-right: 20px; }
  .hero__right { display: none; }
  .hero__scroll { grid-column: 1 / -1; }
  .hero__bg-word { font-size: 15vw; }
}

@media (max-width: 640px) {
  .hero {
    grid-template-columns: 1fr;
    padding: 100px 24px 60px;
    text-align: center;
  }
  .hero__tagline { grid-column: 1; }
  .hero__product { grid-column: 1; grid-row: 2; }
  .hero__left { grid-column: 1; grid-row: 3; align-items: center; padding: 0; }
  .hero__sub { max-width: 100%; }
  .hero__bg-word { display: none; }
  .hero::before { display: none; }
}
</style>