---
// Nav.astro — Elysian Aromas
---

<nav class="nav" id="mainNav">
  <a class="nav__logo" href="/">Elysian</a>

  <div class="nav__right">
    <a class="nav__cta-outline" href="/coleccion">
      Ver colección
      <span class="nav__arrow">→</span>
    </a>
    <button class="nav__menu-btn" id="menuBtn" aria-label="Menú">
      MENÚ
      <span class="nav__dots" aria-hidden="true">••</span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    height: 60px;
    background: #f0ebe2;
    font-family: 'Montserrat', system-ui, sans-serif;
  }

  /* Logo */
  .nav__logo {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #1a1a18;
    text-decoration: none;
  }

  /* Lado derecho */
  .nav__right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Botón outline "Ver colección →" */
  .nav__cta-outline {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 20px;
    height: 40px;
    border-radius: 999px;
    border: 1.5px solid rgba(26,26,24,0.2);
    background: transparent;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1a18;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .nav__cta-outline:hover {
    background: rgba(26,26,24,0.06);
    border-color: rgba(26,26,24,0.4);
  }
  .nav__arrow {
    font-size: 14px;
    transition: transform 0.2s;
  }
  .nav__cta-outline:hover .nav__arrow {
    transform: translateX(3px);
  }

  /* Botón sólido "MENÚ ••" */
  .nav__menu-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 20px;
    height: 40px;
    border-radius: 999px;
    border: none;
    background: #1a1a18;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f0ebe2;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    white-space: nowrap;
  }
  .nav__menu-btn:hover {
    background: #2e2e2b;
    transform: scale(1.02);
  }
  .nav__dots {
    font-size: 8px;
    letter-spacing: 2px;
    opacity: 0.7;
  }

  /* Scroll — agrega sombra sutil */
  .nav.nav--scrolled {
    box-shadow: 0 1px 0 rgba(26,26,24,0.08);
  }
</style>

<script is:inline>
(function () {
  var nav = document.getElementById('mainNav');
  window.addEventListener('scroll', function () {
    if (window.scrollY > 10) {
      nav.classList.add('nav--scrolled');
    } else {
      nav.classList.remove('nav--scrolled');
    }
  }, { passive: true });
})();
</script>