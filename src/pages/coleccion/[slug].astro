---
/**
 * PÁGINA: /coleccion/[slug]  — Detalle de producto
 * ──────────────────────────────────────────────────────────────────────────
 * Layout inspirado en e-commer-astro.vercel.app/product/ipad-pro-m2
 * Estética: Elysian (oscuro, dorado, lujo)
 *
 * SECCIONES:
 *   1. Galería de imágenes con thumbnails (izquierda)
 *   2. Info: título, precio, stock, cantidad, botones CTA (derecha)
 *   3. Pirámide olfativa (notas top/heart/base)
 *   4. Specs técnicas en tabla
 *   5. Descripción completa (HTML de WordPress)
 *   6. Productos relacionados
 *
 * getStaticPaths() → Astro genera una página por cada producto de WordPress.
 * Si añades un producto en WP y haces `npm run build`, aparece automáticamente.
 */

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, getProductBySlug, getRelatedProducts, MOCK_PRODUCTS } from '../../lib/wordpress.js';

export async function getStaticPaths() {
  let products;
  try {
    products = await getProducts({ perPage: 100 });
    if (!products?.length) products = MOCK_PRODUCTS;
  } catch {
    products = MOCK_PRODUCTS;
  }
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { title, description, price, comparePrice, stock, notes, specs, gallery, excerpt, slug } = product;

// Productos relacionados
let related = [];
try {
  related = await getRelatedProducts(slug, { perPage: 3 });
} catch {
  related = MOCK_PRODUCTS.filter(p => p.slug !== slug).slice(0, 3);
}

const inStock = stock > 0;
const lowStock = stock > 0 && stock <= 5;
---

<Layout
  title={`${title} — Elysian Aromas`}
  description={excerpt || ''}
  image={gallery[0]?.url}
>
  <Nav slot="nav" />

  <div class="product-page">

    <!-- ── Breadcrumb ── -->
    <div class="breadcrumb container">
      <a href="/">Home</a>
      <span class="sep">✦</span>
      <a href="/coleccion">Collection</a>
      <span class="sep">✦</span>
      <span>{title}</span>
    </div>

    <!-- ── Main grid ── -->
    <div class="product-main container">

      <!-- ── COLUMNA IZQUIERDA: Galería ── -->
      <div class="gallery" id="gallery">

        <!-- Imagen principal -->
        <div class="gallery__main">
          <img
            src={gallery[0]?.url || product.image}
            alt={gallery[0]?.alt || title}
            class="gallery__main-img"
            id="mainImg"
          />
          <!-- Badge de oferta -->
          {comparePrice && (
            <div class="gallery__badge">SALE</div>
          )}
        </div>

        <!-- Thumbnails (si hay más de 1 imagen) -->
        {gallery.length > 1 && (
          <div class="gallery__thumbs">
            {gallery.map((img, i) => (
              <button
                class:list={['gallery__thumb', { active: i === 0 }]}
                data-src={img.url}
                data-alt={img.alt}
                aria-label={`Ver imagen ${i + 1}`}
              >
                <img src={img.url} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- ── COLUMNA DERECHA: Info ── -->
      <div class="product-info">

        <!-- Categoría / tipo -->
        <p class="product-info__cat">
          {product.categories?.[0] || 'Eau de Parfum'} · {product.size || '50ml'}
        </p>

        <!-- Título -->
        <h1 class="product-info__title">{title}</h1>

        <!-- Excerpt -->
        {excerpt && <p class="product-info__excerpt">{excerpt}</p>}

        <!-- Notas planas (quick view) -->
        {product.notesFlat?.length > 0 && (
          <div class="product-info__notes-quick">
            {product.notesFlat.slice(0, 4).map(n => (
              <span class="note-pill">{n}</span>
            ))}
          </div>
        )}

        <!-- Divider -->
        <div class="product-info__divider"></div>

        <!-- Precios -->
        <div class="product-info__price-row">
          <span class="product-info__price">{price}</span>
          {comparePrice && (
            <span class="product-info__compare">{comparePrice}</span>
          )}
          {comparePrice && (
            <span class="product-info__discount">
              -{Math.round((1 - parseInt(price.replace(/\D/g,'')) / parseInt(comparePrice.replace(/\D/g,''))) * 100)}%
            </span>
          )}
        </div>

        <!-- Stock -->
        <div class:list={['product-info__stock', { 'low': lowStock, 'out': !inStock }]}>
          <span class="stock-dot"></span>
          {inStock
            ? lowStock
              ? `Solo quedan ${stock} unidades`
              : `En stock (${stock} unidades)`
            : 'Agotado'}
        </div>

        <!-- Selector de cantidad -->
        <div class="product-info__qty">
          <span class="product-info__qty-label">Cantidad</span>
          <div class="qty-control">
            <button class="qty-btn" id="qtyMinus" aria-label="Disminuir">−</button>
            <span class="qty-num" id="qtyNum">1</span>
            <button class="qty-btn" id="qtyPlus" aria-label="Aumentar">+</button>
          </div>
        </div>

        <!-- CTAs -->
        <div class="product-info__actions">
          <button class:list={['btn-cart', { disabled: !inStock }]} id="btnCart" disabled={!inStock}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="1.5"/>
              <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="1.5"/>
              <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            {inStock ? 'Añadir al carrito' : 'Agotado'}
          </button>
          <button class="btn-wishlist" aria-label="Añadir a favoritos">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </button>
        </div>

        <!-- Garantías -->
        <div class="product-info__guarantees">
          <div class="guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span>Autenticidad garantizada</span>
          </div>
          <div class="guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <rect x="1" y="3" width="15" height="13" rx="1" stroke="currentColor" stroke-width="1.5"/>
              <path d="M16 8h4l3 3v5h-7V8z" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="5.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="18.5" cy="18.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span>Envío gratuito +€150</span>
          </div>
          <div class="guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <polyline points="20 12 20 22 4 22 4 12" stroke="currentColor" stroke-width="1.5"/>
              <rect x="2" y="7" width="20" height="5" stroke="currentColor" stroke-width="1.5"/>
              <line x1="12" y1="22" x2="12" y2="7" stroke="currentColor" stroke-width="1.5"/>
              <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span>30 días para devoluciones</span>
          </div>
        </div>

      </div>
    </div>

    <!-- ── SECCIÓN: Pirámide olfativa + Specs ── -->
    <div class="product-details container">

      <!-- Pirámide olfativa -->
      {(notes?.top?.length || notes?.heart?.length || notes?.base?.length) && (
        <div class="fragrance-pyramid">
          <h2 class="section-title">Pirámide olfativa</h2>
          <div class="pyramid">
            {notes.top?.length > 0 && (
              <div class="pyramid__level pyramid__level--top">
                <div class="pyramid__label">
                  <span class="pyramid__time">0–30 min</span>
                  <span class="pyramid__name">Notas de salida</span>
                </div>
                <div class="pyramid__notes">
                  {notes.top.map(n => <span class="pyramid__note">{n}</span>)}
                </div>
              </div>
            )}
            {notes.heart?.length > 0 && (
              <div class="pyramid__level pyramid__level--heart">
                <div class="pyramid__label">
                  <span class="pyramid__time">30 min–4 h</span>
                  <span class="pyramid__name">Notas de corazón</span>
                </div>
                <div class="pyramid__notes">
                  {notes.heart.map(n => <span class="pyramid__note">{n}</span>)}
                </div>
              </div>
            )}
            {notes.base?.length > 0 && (
              <div class="pyramid__level pyramid__level--base">
                <div class="pyramid__label">
                  <span class="pyramid__time">4 h+</span>
                  <span class="pyramid__name">Notas de fondo</span>
                </div>
                <div class="pyramid__notes">
                  {notes.base.map(n => <span class="pyramid__note">{n}</span>)}
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Specs técnicas -->
      {specs?.length > 0 && (
        <div class="specs">
          <h2 class="section-title">Especificaciones</h2>
          <table class="specs__table">
            {specs.map(s => (
              <tr class="specs__row">
                <td class="specs__label">{s.label}</td>
                <td class="specs__value">{s.value}</td>
              </tr>
            ))}
          </table>
        </div>
      )}

      <!-- Descripción larga de WordPress -->
      {description && (
        <div class="product-description">
          <h2 class="section-title">Sobre esta fragancia</h2>
          <div class="product-description__body" set:html={description} />
        </div>
      )}

    </div>

    <!-- ── SECCIÓN: Relacionados ── -->
    {related.length > 0 && (
      <section class="related">
        <div class="container">
          <div class="related__header">
            <div class="gold-line"></div>
            <h2 class="related__title">También te puede gustar</h2>
          </div>
          <div class="related__grid">
            {related.map(p => <ProductCard {...p} />)}
          </div>
        </div>
      </section>
    )}

  </div>

  <Footer slot="footer" />
</Layout>

<!-- ── SCRIPTS ── -->
<script>
  // Galería: cambiar imagen principal al hacer click en thumbnail
  const mainImg = document.getElementById('mainImg') as HTMLImageElement;
  const thumbs = document.querySelectorAll('.gallery__thumb');

  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      const src = (thumb as HTMLElement).dataset.src;
      const alt = (thumb as HTMLElement).dataset.alt;
      if (mainImg && src) {
        mainImg.src = src;
        mainImg.alt = alt || '';
        // Fade rápido
        mainImg.style.opacity = '0';
        setTimeout(() => mainImg.style.opacity = '1', 50);
      }
      // Active state
      thumbs.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
    });
  });

  // Selector de cantidad
  const qtyNum = document.getElementById('qtyNum');
  const qtyMinus = document.getElementById('qtyMinus');
  const qtyPlus = document.getElementById('qtyPlus');
  let qty = 1;

  qtyMinus?.addEventListener('click', () => {
    if (qty > 1) { qty--; if(qtyNum) qtyNum.textContent = String(qty); }
  });
  qtyPlus?.addEventListener('click', () => {
    qty++;
    if(qtyNum) qtyNum.textContent = String(qty);
  });

  // Carrito (placeholder — aquí conectarías tu sistema de carrito real)
  const btnCart = document.getElementById('btnCart');
  btnCart?.addEventListener('click', () => {
    // TODO: conectar con WooCommerce REST API o tu sistema de carrito
    // Por ahora muestra un feedback visual
    const original = btnCart.textContent;
    btnCart.textContent = '✓ Añadido';
    btnCart.style.background = '#2d5a3d';
    setTimeout(() => {
      btnCart.textContent = original;
      btnCart.style.background = '';
    }, 2000);
  });
</script>

<style>
/* ── Layout general ── */
.product-page { padding-top: 100px; }

/* ── Breadcrumb ── */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 24px 0;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.4;
  border-bottom: 1px solid var(--c-border-soft);
  margin-bottom: 60px;
}
.breadcrumb a:hover { opacity: 1; color: var(--c-gold); }
.sep { font-size: 8px; opacity: 0.4; }

/* ── Main grid: galería + info ── */
.product-main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
  margin-bottom: 100px;
}

/* ── Galería ── */
.gallery__main {
  position: sticky;
  top: 100px;
  position: relative;
  background: var(--c-bg-card);
  border: 1px solid var(--c-border-soft);
  overflow: hidden;
  aspect-ratio: 4/5;
}
.gallery__main-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease, transform 0.6s ease;
}
.gallery__main:hover .gallery__main-img { transform: scale(1.03); }

.gallery__badge {
  position: absolute;
  top: 20px;
  left: 20px;
  background: var(--c-gold);
  color: var(--c-bg);
  font-size: 10px;
  letter-spacing: 0.2em;
  padding: 6px 14px;
  font-weight: 500;
}

.gallery__thumbs {
  display: flex;
  gap: 12px;
  margin-top: 12px;
}
.gallery__thumb {
  flex: 1;
  aspect-ratio: 1;
  overflow: hidden;
  border: 1px solid var(--c-border-soft);
  cursor: pointer;
  transition: border-color 0.3s;
  padding: 0;
}
.gallery__thumb img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}
.gallery__thumb:hover img { transform: scale(1.08); }
.gallery__thumb.active { border-color: var(--c-gold); }

/* ── Info de producto ── */
.product-info__cat {
  font-size: 10px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--c-gold);
  opacity: 0.7;
  margin-bottom: 16px;
}

.product-info__title {
  font-size: clamp(36px, 4vw, 60px);
  font-weight: 300;
  color: var(--c-cream);
  line-height: 1.05;
  margin-bottom: 16px;
}

.product-info__excerpt {
  font-size: 13px;
  color: var(--c-cream);
  opacity: 0.55;
  line-height: 1.6;
  margin-bottom: 20px;
}

/* Pills de notas rápidas */
.product-info__notes-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 20px;
}
.note-pill {
  font-size: 10px;
  letter-spacing: 0.1em;
  border: 1px solid var(--c-border);
  color: var(--c-gold);
  padding: 5px 12px;
  opacity: 0.7;
}

.product-info__divider {
  height: 1px;
  background: var(--c-border-soft);
  margin: 24px 0;
}

/* Precios */
.product-info__price-row {
  display: flex;
  align-items: baseline;
  gap: 16px;
  margin-bottom: 16px;
}
.product-info__price {
  font-family: var(--f-serif);
  font-size: 52px;
  color: var(--c-gold);
  line-height: 1;
}
.product-info__compare {
  font-size: 20px;
  color: var(--c-muted);
  text-decoration: line-through;
  font-family: var(--f-serif);
}
.product-info__discount {
  font-size: 12px;
  background: rgba(201,169,110,0.15);
  color: var(--c-gold);
  padding: 4px 10px;
  letter-spacing: 0.1em;
}

/* Stock */
.product-info__stock {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--c-cream);
  opacity: 0.6;
  margin-bottom: 28px;
}
.stock-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #4caf7d; /* verde = en stock */
  flex-shrink: 0;
}
.product-info__stock.low .stock-dot { background: #e6a817; }
.product-info__stock.out .stock-dot { background: #c0392b; }

/* Cantidad */
.product-info__qty {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
}
.product-info__qty-label {
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--c-cream);
  opacity: 0.5;
}
.qty-control {
  display: flex;
  align-items: center;
  border: 1px solid var(--c-border);
}
.qty-btn {
  width: 40px; height: 40px;
  background: transparent;
  color: var(--c-cream);
  font-size: 18px;
  transition: background 0.2s;
  cursor: pointer;
  border: none;
}
.qty-btn:hover { background: rgba(201,169,110,0.1); color: var(--c-gold); }
.qty-num {
  width: 48px;
  text-align: center;
  font-size: 15px;
  color: var(--c-cream);
  border-left: 1px solid var(--c-border);
  border-right: 1px solid var(--c-border);
  height: 40px;
  line-height: 40px;
  display: block;
}

/* Botones CTA */
.product-info__actions {
  display: flex;
  gap: 12px;
  margin-bottom: 36px;
}
.btn-cart {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--c-gold);
  color: var(--c-bg);
  padding: 18px 32px;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-family: var(--f-sans);
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: background 0.3s, transform 0.2s;
}
.btn-cart:hover:not(.disabled) { background: var(--c-gold-light); transform: translateY(-2px); }
.btn-cart.disabled { background: var(--c-muted); cursor: not-allowed; opacity: 0.5; }

.btn-wishlist {
  width: 58px; height: 58px;
  border: 1px solid var(--c-border);
  color: var(--c-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  cursor: pointer;
  background: transparent;
  flex-shrink: 0;
}
.btn-wishlist:hover { border-color: var(--c-gold); color: var(--c-gold); }

/* Garantías */
.product-info__guarantees {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 24px;
  border: 1px solid var(--c-border-soft);
  background: rgba(201,169,110,0.03);
}
.guarantee-item {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 12px;
  color: var(--c-cream);
  opacity: 0.55;
}
.guarantee-item svg { color: var(--c-gold); opacity: 0.7; flex-shrink: 0; }

/* ── Sección detalle: pirámide + specs ── */
.product-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  margin-bottom: 100px;
  padding-bottom: 80px;
  border-bottom: 1px solid var(--c-border-soft);
}

.section-title {
  font-size: 11px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--c-gold);
  opacity: 0.7;
  margin-bottom: 32px;
}

/* Pirámide olfativa */
.pyramid {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.pyramid__level {
  display: flex;
  align-items: start;
  gap: 24px;
  padding: 20px 0;
  border-bottom: 1px solid var(--c-border-soft);
  position: relative;
}
.pyramid__level::before {
  content: '';
  width: 3px;
  align-self: stretch;
  border-radius: 2px;
  flex-shrink: 0;
}
.pyramid__level--top::before    { background: rgba(201,169,110,0.4); }
.pyramid__level--heart::before  { background: rgba(201,169,110,0.65); }
.pyramid__level--base::before   { background: var(--c-gold); }

.pyramid__label { display: flex; flex-direction: column; gap: 4px; min-width: 110px; }
.pyramid__time { font-size: 10px; color: var(--c-gold); opacity: 0.6; letter-spacing: 0.1em; }
.pyramid__name { font-size: 12px; color: var(--c-cream); opacity: 0.7; }

.pyramid__notes { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.pyramid__note {
  font-size: 12px;
  color: var(--c-cream);
  background: rgba(201,169,110,0.07);
  border: 1px solid var(--c-border-soft);
  padding: 5px 14px;
}

/* Specs */
.specs__table { width: 100%; border-collapse: collapse; }
.specs__row {
  border-bottom: 1px solid var(--c-border-soft);
  transition: background 0.2s;
}
.specs__row:hover { background: rgba(201,169,110,0.04); }
.specs__label, .specs__value { padding: 14px 8px; font-size: 13px; }
.specs__label { color: var(--c-cream); opacity: 0.45; width: 45%; }
.specs__value { color: var(--c-cream); }

/* Descripción larga */
.product-description { grid-column: 1 / -1; }
.product-description__body {
  font-size: 14px;
  line-height: 1.9;
  color: var(--c-cream);
  opacity: 0.6;
  max-width: 680px;
}
.product-description__body p { margin-bottom: 16px; }
.product-description__body p:last-child { margin-bottom: 0; }

/* ── Relacionados ── */
.related { padding: 80px 0 120px; }
.related__header {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 48px;
}
.related__title {
  font-size: 11px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--c-gold);
  opacity: 0.7;
