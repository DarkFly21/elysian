---
/**
 * PÁGINA PRINCIPAL — index.astro
 * ──────────────────────────────────────────────────────
 * En Astro, cada archivo en src/pages/ se convierte en una ruta.
 * src/pages/index.astro → / (la página de inicio)
 * src/pages/coleccion/index.astro → /coleccion
 * src/pages/coleccion/[slug].astro → /coleccion/algun-producto
 *
 * EL BLOQUE --- --- ES EL "FRONTMATTER"
 * Es código JavaScript/TypeScript que se ejecuta en el SERVIDOR
 * (o en tiempo de build). Aquí es donde pedimos datos a WordPress.
 * El usuario NUNCA ve este código, solo el HTML resultante.
 *
 * ¿POR QUÉ ESTO ES MEJOR QUE REACT/NEXT PARA SEO?
 * Astro genera HTML estático por defecto. Google puede leer el contenido
 * directamente sin esperar a que JavaScript lo renderice.
 */

// Importamos el layout base
import Layout from '../layouts/Layout.astro';

// Importamos los componentes
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import CollectionSection from '../components/CollectionSection.astro';
import AboutSection from '../components/AboutSection.astro';
import IngredientsSection from '../components/IngredientsSection.astro';
import Footer from '../components/Footer.astro';

// Importamos la función que conecta con WordPress
import { getProducts, MOCK_PRODUCTS } from '../lib/wordpress.js';

/**
 * FETCH DE DATOS EN BUILD TIME
 * Esta llamada ocurre cuando Astro construye el sitio (npm run build).
 * El resultado queda "horneado" en el HTML estático.
 *
 * Si WordPress no está configurado todavía, usa MOCK_PRODUCTS.
 * Cuando configures WP_URL en .env, automáticamente usará WordPress.
 */
let products;
try {
  products = await getProducts({ perPage: 3 }); // Solo 3 para la home
  
  // Si no hay productos de WP, usamos los de prueba
  if (!products || products.length === 0) {
    products = MOCK_PRODUCTS;
  }
} catch (error) {
  console.error('No se pudieron cargar productos:', error);
  products = MOCK_PRODUCTS; // Fallback a mock data
}
---

<Layout
  title="Elysian Aromas — Luxury Fragrances"
  description="A luxury perfume company that creates unforgettable scents, leaving an unforgettable impression."
>
  <!-- slot="nav" va al <slot name="nav" /> del Layout -->
  <Nav slot="nav" />

  <!-- Secciones de la página (orden visual) -->
  <Hero />
  <Marquee />
  <CollectionSection products={products} />
  <AboutSection />
  <IngredientsSection />

  <!-- slot="footer" va al <slot name="footer" /> del Layout -->
  <Footer slot="footer" />
</Layout>
