---
/**
 * LAYOUT BASE
 * ────────────────────────────────────────────────────
 * Este layout envuelve TODAS las páginas.
 * Contiene: <head> con meta tags, Nav, Footer, y el cursor personalizado.
 *
 * En Astro, los layouts son como "plantillas" reutilizables.
 * Cada página dice: layout="../layouts/Layout.astro"
 */

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Elysian Aromas — Luxury Fragrances',
  description = 'A luxury perfume company that creates unforgettable scents.',
  image = '/og-image.jpg',
} = Astro.props;

// Astro.url nos da la URL actual (útil para el canonical)
// Astro.site puede ser undefined si no está configurado en astro.config.mjs
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- SEO Básico -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph (para compartir en redes) -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:type" content="website" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- CSS Global -->
  <link rel="stylesheet" href="/styles/global.css" />
</head>

<body class="grain">

  <!-- Cursor personalizado (solo desktop) -->
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <!-- Navegación -->
  <slot name="nav" />

  <!-- Contenido de la página -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <slot name="footer" />

  <!-- Script del cursor -->
  <script>
    const cursor = document.getElementById('cursor');
    const ring = document.getElementById('cursorRing');
    let mouseX = 0, mouseY = 0;
    let ringX = 0, ringY = 0;

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      cursor.style.left = mouseX - 4 + 'px';
      cursor.style.top = mouseY - 4 + 'px';
    });

    // El ring sigue con un pequeño lag para efecto suave
    function animateRing() {
      ringX += (mouseX - ringX) * 0.12;
      ringY += (mouseY - ringY) * 0.12;
      ring.style.left = ringX - 16 + 'px';
      ring.style.top = ringY - 16 + 'px';
      requestAnimationFrame(animateRing);
    }
    animateRing();

    // El ring se expande al hacer hover sobre links/botones
    document.querySelectorAll('a, button').forEach(el => {
      el.addEventListener('mouseenter', () => {
        ring.style.transform = 'scale(2)';
        ring.style.opacity = '0.3';
      });
      el.addEventListener('mouseleave', () => {
        ring.style.transform = 'scale(1)';
        ring.style.opacity = '0.6';
      });
    });
  </script>

</body>
</html>

<!-- Importamos el CSS global aquí para que Astro lo procese -->
<style is:global>
  @import '../styles/global.css';
</style>
